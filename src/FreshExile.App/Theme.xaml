<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:FreshExile.App"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- display: titles, tabs, section heads, item names, the brand; body and numbers stay UiFont / MonoFont -->
    <FontFamily x:Key="DisplayFont">pack://application:,,,/Fonts/#Alegreya SC</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <SolidColorBrush x:Key="PanelBrush" Color="#0F0C09"/>
    <SolidColorBrush x:Key="Surface" Color="#17120D"/>
    <SolidColorBrush x:Key="Surface2" Color="#211A12"/>
    <SolidColorBrush x:Key="Surface3" Color="#2A2117"/>
    <SolidColorBrush x:Key="Line" Color="#33291D"/>
    <SolidColorBrush x:Key="LineStrong" Color="#4E3F2C"/>
    <SolidColorBrush x:Key="Text" Color="#EDE3CF"/>
    <SolidColorBrush x:Key="Text2" Color="#B5A68C"/>
    <SolidColorBrush x:Key="Text3" Color="#8C7E68"/>
    <!-- the accent is the flame of the logo's compass needle: buttons, ticks, the current stage, toasts -->
    <SolidColorBrush x:Key="Accent" Color="#E8A445"/>
    <SolidColorBrush x:Key="AccentHover" Color="#F5C26B"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#C9913F"/>
    <!-- the accent at low strength: a selected row, a tinted chip -->
    <SolidColorBrush x:Key="AccentSoft" Color="#1FE8A445"/>
    <SolidColorBrush x:Key="OnAccent" Color="#0F0C09"/>

    <!-- bronze: ornaments (diamond dividers, brand captions), the frame of a picked card, socket links -->
    <SolidColorBrush x:Key="Bronze" Color="#C9913F"/>
    <SolidColorBrush x:Key="BronzeLine" Color="#6B5332"/>
    <SolidColorBrush x:Key="BronzeText" Color="#C9B48E"/>
    <SolidColorBrush x:Key="HoverBorder" Color="#6B5332"/>
    <SolidColorBrush x:Key="TitleText" Color="#F3E6C8"/>
    <SolidColorBrush x:Key="Well" Color="#0C0A07"/>
    <SolidColorBrush x:Key="Selection" Color="#88FFE6B4"/>
    <!-- the window's top inner highlight -->
    <SolidColorBrush x:Key="Glint" Color="#12FFD696"/>
    <SolidColorBrush x:Key="Backdrop" Color="#F00F0C09"/>

    <!-- sockets: as in the game -->
    <SolidColorBrush x:Key="SocketR" Color="#D0503F"/>
    <SolidColorBrush x:Key="SocketG" Color="#5FA845"/>
    <SolidColorBrush x:Key="SocketB" Color="#5B86D9"/>
    <SolidColorBrush x:Key="SocketW" Color="#D8D2C4"/>
    <LinearGradientBrush x:Key="SocketLink" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#5A4428" Offset="0"/>
        <GradientStop Color="#B08A4E" Offset="0.5"/>
        <GradientStop Color="#5A4428" Offset="1"/>
    </LinearGradientBrush>

    <!-- item rarity -->
    <SolidColorBrush x:Key="RarityUnique" Color="#D8803A"/>
    <SolidColorBrush x:Key="RarityRare" Color="#F2E36C"/>
    <SolidColorBrush x:Key="RarityMagic" Color="#A9A9FF"/>
    <SolidColorBrush x:Key="Gold" Color="#E2BE62"/>

    <SolidColorBrush x:Key="Danger" Color="#C24545"/>
    <SolidColorBrush x:Key="DangerLine" Color="#D96A6A"/>
    <SolidColorBrush x:Key="Taken" Color="#9C9CA3"/>
    <SolidColorBrush x:Key="White" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="WhiteSoft" Color="#30FFFFFF"/>
    <SolidColorBrush x:Key="AccentFaint" Color="#1AE8A445"/>
    <SolidColorBrush x:Key="AccentDim" Color="#33E8A445"/>
    <Color x:Key="TreeBgColor">#08080A</Color>
    <Color x:Key="FlameColor">#E8A445</Color>
    <!-- the panel and raised-surface colours as Color, for gradients -->
    <Color x:Key="PanelColor">#0F0C09</Color>
    <Color x:Key="Surface2Color">#211A12</Color>
    <Color x:Key="PanelClearColor">#000F0C09</Color>
    <Color x:Key="FlameSoftColor">#26E8A445</Color>
    <SolidColorBrush x:Key="DangerSoft" Color="#4A1F1A"/>
    <SolidColorBrush x:Key="DangerText" Color="#F0B4A8"/>
    <SolidColorBrush x:Key="Ok" Color="#6DBE5A"/>
    <!-- runegrafts and tattoos on the trees and in their blocks over the game's tree -->
    <SolidColorBrush x:Key="RuneColor" Color="#4FD8E0"/>
    <SolidColorBrush x:Key="TattooColor" Color="#B48CF0"/>

    <!-- type scale and corner radii: nothing in between -->
    <sys:Double x:Key="FsCaption">11</sys:Double>
    <sys:Double x:Key="FsSmall">12</sys:Double>
    <sys:Double x:Key="FsBody">13</sys:Double>
    <sys:Double x:Key="FsSection">15</sys:Double>
    <sys:Double x:Key="FsTitle">20</sys:Double>
    <sys:Double x:Key="FsHero">30</sys:Double>
    <CornerRadius x:Key="RadiusS">4</CornerRadius>
    <CornerRadius x:Key="RadiusM">6</CornerRadius>
    <CornerRadius x:Key="RadiusL">10</CornerRadius>

    <!-- icon button: 32x32, glyph from Segoe Fluent Icons -->
    <Style x:Key="IconButton" TargetType="ButtonBase">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Foreground" Value="{StaticResource Text2}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FsSmall}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="b" SnapsToDevicePixels="True" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusM}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Surface2}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Surface3}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource IconButton}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{StaticResource FsBody}"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" SnapsToDevicePixels="True" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusM}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{StaticResource FsSmall}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" SnapsToDevicePixels="True" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource RadiusM}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Surface2}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource HoverBorder}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- whole gem row is the checkbox: click anywhere on the row -->
    <Style x:Key="GemCheck" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="row" Background="Transparent" CornerRadius="{StaticResource RadiusM}" Padding="7,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="box" Width="16" Height="16" CornerRadius="{StaticResource RadiusS}" BorderThickness="1.5"
                                    BorderBrush="{StaticResource LineStrong}" Background="Transparent" VerticalAlignment="Top" Margin="0,1,0,0">
                                <Path x:Name="mark" Data="M3.2,8.4 L6.5,11.4 L12.6,4.8" Stroke="{StaticResource OnAccent}" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Margin="-1.5" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="row" Property="Background" Value="{StaticResource Surface2}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Text2}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource Accent}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- gem row: round orb in the gem's socket colour (OrbStroke / OrbFill from the row) -->
    <Style x:Key="GemOrb" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="row" Background="Transparent" CornerRadius="{StaticResource RadiusM}" Padding="7,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0">
                                <Ellipse x:Name="orb" Fill="{Binding OrbFill}" Opacity="0.22"/>
                                <Ellipse x:Name="ring" Stroke="{Binding OrbStroke}" StrokeThickness="1.2" Opacity="0.45"/>
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="row" Property="Background" Value="{StaticResource Surface2}"/>
                            <Setter TargetName="ring" Property="Opacity" Value="0.8"/>
                            <Setter TargetName="orb" Property="Opacity" Value="0.4"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="orb" Property="Opacity" Value="1"/>
                            <Setter TargetName="ring" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- gem row of a link card: the whole row is the "bought" checkbox; on the left the gem's socket (filled once bought),
         the link bar under the sockets is drawn by the card's LinkedStackPanel (socket centre at 17,16: padding 5 + half of the 22 px line) -->
    <Style x:Key="GemSocket" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="row" Background="Transparent" CornerRadius="{StaticResource RadiusM}" Padding="6,5,4,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <l:SocketDot Width="22" Height="22" VerticalAlignment="Top" Color="{Binding OrbStroke}"
                                         Filled="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Gap="{StaticResource Surface}"/>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <!-- see-through, so the link bar under the sockets stays visible -->
                            <Setter TargetName="row" Property="Background" Value="{StaticResource AccentFaint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Text3}"/>
        <Setter Property="FontSize" Value="{StaticResource FsSmall}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" SnapsToDevicePixels="True" Background="Transparent" CornerRadius="{StaticResource RadiusM}" Padding="0,6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Surface3}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- toggle button: plain rectangular button, a check mark shows the "on" state -->
    <Style x:Key="Chip" TargetType="ToggleButton">
        <Setter Property="FontSize" Value="{StaticResource FsSmall}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text2}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" SnapsToDevicePixels="True" CornerRadius="{StaticResource RadiusM}" BorderThickness="1" BorderBrush="{StaticResource LineStrong}"
                            Background="Transparent" Padding="{TemplateBinding Padding}">
                        <!-- vector icon, not a font glyph: glyph baselines sit off-centre next to text -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="check" Data="M1,5.2 L3.8,8 L9,2" Width="10" Height="10" Stretch="None"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Surface2}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource HoverBorder}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentSoft}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Bronze}"/>
                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Selection}"/>
        <Setter Property="FontSize" Value="{StaticResource FsBody}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" SnapsToDevicePixels="True" CornerRadius="{StaticResource RadiusM}" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <Grid>
                            <!-- TextBox applies Padding to the content host itself -->
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{StaticResource Text3}" Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource HoverBorder}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Text2}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- stage stepper bar -->
    <Style x:Key="Pip" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Height="16" Padding="1.5,0">
                        <Border x:Name="bar" Height="3" CornerRadius="1.5" Background="{StaticResource Line}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsPast}" Value="True">
                            <Setter TargetName="bar" Property="Background" Value="{StaticResource LineStrong}"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bar" Property="Background" Value="{StaticResource Text2}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter TargetName="bar" Property="Background" Value="{StaticResource Accent}"/>
                            <Setter TargetName="bar" Property="Height" Value="5"/>
                            <Setter TargetName="bar" Property="CornerRadius" Value="2.5"/>
                            <!-- the current stage glows like the flame -->
                            <Setter TargetName="bar" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource FlameColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"><Border Height="2" CornerRadius="1" Background="{StaticResource Text2}" VerticalAlignment="Center"/></Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderBlank" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Thin" TargetType="Slider">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="20" Background="Transparent">
                        <Border Height="2" CornerRadius="1" Background="{StaticResource LineStrong}" VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFill}"/></Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderBlank}"/></Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="12" Height="12" Cursor="Hand">
                                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{StaticResource Accent}"/></ControlTemplate></Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6"/>
        <Setter Property="MinWidth" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb"><Border CornerRadius="{StaticResource RadiusS}" Background="{StaticResource LineStrong}"/></ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Track" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FsSmall}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusM}" Padding="9,5" MaxWidth="360">
                        <ContentPresenter>
                            <!-- a plain string wraps at 360 px instead of running off the screen in one line -->
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type sys:String}">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="17"/>
                                </DataTemplate>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- socket change: "Volley  →  Greater Volley", "Herald  →  убрать", "+ Grace" -->
    <DataTemplate x:Key="SwapLine">
        <TextBlock x:Name="line" FontSize="{StaticResource FsSmall}" TextWrapping="Wrap" Margin="0,1,0,2">
            <Run Text="{Binding OldText, Mode=OneWay}" Foreground="{StaticResource Text2}"/><Run Text="{Binding Arrow, Mode=OneWay}" Foreground="{StaticResource Text3}"/><Run x:Name="next" Text="{Binding NewText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
        </TextBlock>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsRemoval}" Value="True">
                <Setter TargetName="next" Property="FontWeight" Value="Normal"/>
                <Setter TargetName="next" Property="Foreground" Value="{StaticResource Text3}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FsCaption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Text3}"/>
    </Style>

    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusS}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource Text2}"/>
        <Setter Property="Padding" Value="6,0,6,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===== shared pieces of the bronze-and-flame look ===== -->

    <!-- window frame: 1 px LineStrong, radius 10, a faint warm highlight along the top edge. The outline is two filled
         layers: a stroked rounded border looks thinner on the arcs than on the straight edges -->
    <Style x:Key="WindowFrame" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{StaticResource LineStrong}" CornerRadius="{StaticResource RadiusL}" Padding="1" UseLayoutRounding="False">
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="9">
                            <Grid>
                                <Border Height="1" VerticalAlignment="Top" Margin="10,0" Background="{StaticResource Glint}"/>
                                <ContentPresenter/>
                            </Grid>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <LinearGradientBrush x:Key="OrnamentFadeIn" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="Transparent" Offset="0"/>
        <GradientStop Color="#4E3F2C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OrnamentFadeOut" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#4E3F2C" Offset="0"/>
        <GradientStop Color="Transparent" Offset="1"/>
    </LinearGradientBrush>

    <!-- line fading in · diamond · caption · diamond · line fading out -->
    <Style TargetType="l:OrnamentDivider">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="l:OrnamentDivider">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="1" Background="{StaticResource OrnamentFadeIn}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0">
                            <Rectangle Width="5" Height="5" Fill="{StaticResource Bronze}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
                            </Rectangle>
                            <TextBlock x:Name="text" Text="{TemplateBinding Text}" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FsBody}"
                                       Foreground="{StaticResource BronzeText}" Margin="8,0" VerticalAlignment="Center"/>
                            <Rectangle x:Name="second" Width="5" Height="5" Fill="{StaticResource Bronze}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
                            </Rectangle>
                        </StackPanel>
                        <Border Grid.Column="2" Height="1" Background="{StaticResource OrnamentFadeOut}" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasText" Value="False">
                            <Setter TargetName="text" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="second" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- panel tab: no pill, display font; the open one bright with a 2 px flame underline; Tag = a count badge (empty = none) -->
    <Style x:Key="PanelTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Text3}"/>
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FsSection}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent" Height="36">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter VerticalAlignment="Center"/>
                            <Border x:Name="badge" Background="{StaticResource Accent}" CornerRadius="8" Padding="6,0,6,1" Margin="6,1,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FsCaption}"
                                           FontWeight="SemiBold" Foreground="{StaticResource OnAccent}"/>
                            </Border>
                        </StackPanel>
                        <Border x:Name="line" Height="2" VerticalAlignment="Bottom" Background="{StaticResource Accent}" Visibility="Hidden"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="badge" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="">
                            <Setter TargetName="badge" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TitleText}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter TargetName="line" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- one option of a TriSegment -->
    <Style x:Key="TriOption" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource Text2}"/>
        <Setter Property="FontSize" Value="{StaticResource FsSmall}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" SnapsToDevicePixels="True" Background="Transparent" CornerRadius="{StaticResource RadiusS}" MinWidth="36" Padding="7,0" Height="26">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Surface3}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- the "нет" option: picked, it shows in the danger colours -->
    <Style x:Key="TriOptionNo" TargetType="ToggleButton" BasedOn="{StaticResource TriOption}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" SnapsToDevicePixels="True" Background="Transparent" CornerRadius="{StaticResource RadiusS}" MinWidth="36" Padding="7,0" Height="26">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource DangerSoft}"/>
                            <Setter Property="Foreground" Value="{StaticResource DangerText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "Коррапт  [любой · да · нет]" -->
    <Style TargetType="l:TriSegment">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="l:TriSegment">
                    <!-- the caption shares one width with its neighbours (Grid.IsSharedSizeScope on the container), right against the segment -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="TriLabel"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Content="{TemplateBinding Label}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"
                                          TextElement.FontSize="{StaticResource FsSmall}" TextElement.Foreground="{StaticResource Text2}"/>
                        <Border Grid.Column="1" Background="{StaticResource Well}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusM}" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="PART_Any" Style="{StaticResource TriOption}" Content="{l:T 'любой'}"/>
                                <ToggleButton x:Name="PART_Yes" Style="{StaticResource TriOption}" Content="{l:T 'да'}"/>
                                <ToggleButton x:Name="PART_No" Style="{StaticResource TriOptionNo}" Content="{l:T 'нет'}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- on/off switch for the settings: 34x20, on = flame -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="0,0,12,0"/>
                        <Border x:Name="track" Grid.Column="1" Width="34" Height="20" CornerRadius="10" Background="{StaticResource Surface3}"
                                BorderBrush="{StaticResource LineStrong}" BorderThickness="1" VerticalAlignment="Top" Margin="0,1,0,0">
                            <Ellipse x:Name="knob" Width="14" Height="14" Fill="{StaticResource Text2}" HorizontalAlignment="Left" Margin="2,0"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource HoverBorder}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource Accent}"/>
                            <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter TargetName="knob" Property="Fill" Value="{StaticResource OnAccent}"/>
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- a gem's socket link: a 4 px bronze bar drawn under the dots, centre to centre -->
    <Style x:Key="SocketLinkBar" TargetType="Border">
        <Setter Property="Width" Value="4"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Background" Value="{StaticResource SocketLink}"/>
    </Style>

    <!-- a small action button in a card head: "Поиск", "✓ Сделано" -->
    <Style x:Key="SmallButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource AccentHover}"/>
        <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BronzeLine}"/>
        <Setter Property="FontSize" Value="{StaticResource FsCaption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="b" SnapsToDevicePixels="True" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusS}" Padding="8,0" MinHeight="24">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Bronze}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- a section heading in the settings: "Язык ◆ ─────" in the display font, the ornament running out to the right -->
    <Style x:Key="SectionHeader" TargetType="l:OrnamentDivider">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Margin" Value="0,22,0,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="l:OrnamentDivider">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{TemplateBinding Text}" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FsSection}"
                                   FontWeight="Medium" Foreground="{StaticResource BronzeText}" VerticalAlignment="Center"/>
                        <Rectangle Grid.Column="1" Width="5" Height="5" Fill="{StaticResource Bronze}" VerticalAlignment="Center" Margin="10,1,8,0"
                                   RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Border Grid.Column="2" Height="1" Background="{StaticResource OrnamentFadeOut}" VerticalAlignment="Center" Margin="0,1,0,0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "подробнее ›" as a quiet link -->
    <Style x:Key="LinkToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource Bronze}"/>
        <Setter Property="FontSize" Value="{StaticResource FsSmall}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <ContentPresenter x:Name="c" VerticalAlignment="Top"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AccentHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- a long hint: its first sentence and "подробнее ›"; the rest opens under it -->
    <Style TargetType="l:FoldHint">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="l:FoldHint">
                    <StackPanel>
                        <DockPanel>
                            <ToggleButton x:Name="toggle" DockPanel.Dock="Right" Style="{StaticResource LinkToggle}" Margin="10,0,0,0"
                                          IsChecked="{Binding IsOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Content="{l:T 'подробнее ›'}"/>
                            <TextBlock Text="{TemplateBinding Short}" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource Text2}" TextWrapping="Wrap"/>
                        </DockPanel>
                        <TextBlock x:Name="more" Text="{TemplateBinding More}" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource Text2}"
                                   TextWrapping="Wrap" LineHeight="17" Margin="0,4,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsOpen" Value="True">
                            <Setter TargetName="more" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="toggle" Property="Content" Value="{l:T 'свернуть'}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- an option in the settings: what it is, a line on what it changes, the switch on the right -->
    <Style x:Key="OptionSwitch" TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitch}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <!-- a card of options: rows split by thin lines -->
    <Style x:Key="OptionCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusM}"/>
        <Setter Property="Padding" Value="14,4"/>
    </Style>
    <Style x:Key="OptionRow" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="0,10"/>
    </Style>
    <Style x:Key="OptionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FsBody}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="OptionNote" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FsSmall}"/>
        <Setter Property="Foreground" Value="{StaticResource Text2}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

</ResourceDictionary>
