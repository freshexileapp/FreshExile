<Window x:Class="FreshExile.App.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FreshExile.App"
        Title="{l:T 'Fresh Exile · поиск на трейде'}" Width="470" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        UseLayoutRounding="True">

    <ContentControl Style="{StaticResource WindowFrame}">
        <StackPanel UseLayoutRounding="True">
            <Grid Margin="16,12,8,0" Background="Transparent" MouseLeftButtonDown="Drag_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{l:T 'ПОИСК НА ТРЕЙДЕ'}" Style="{StaticResource Caption}" FontSize="{StaticResource FsCaption}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="{StaticResource FsCaption}" ToolTip="{l:T 'Закрыть · Esc'}" Click="Close_Click"/>
            </Grid>

            <TextBox x:Name="Query" Style="{StaticResource Field}" Margin="14,8,14,0"
                     Tag="{l:T 'Название: shaper guardian map, mageblood, divine…'}"
                     TextChanged="Query_TextChanged" PreviewKeyDown="Query_PreviewKeyDown"/>

            <TextBlock x:Name="StatusText" Margin="16,8,16,0" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource Text3}" TextWrapping="Wrap"/>

            <ListBox x:Name="Results" Margin="8,6,8,10" MaxHeight="420" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" Focusable="False"
                     PreviewMouseLeftButtonUp="Results_MouseLeftButtonUp">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="b" CornerRadius="{StaticResource RadiusM}" Padding="8,5" Background="Transparent" Cursor="Hand">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="{StaticResource Surface}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="{StaticResource Surface3}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontSize="{StaticResource FsBody}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding Note}" Foreground="{StaticResource Text3}" FontSize="{StaticResource FsCaption}" Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </ContentControl>
</Window>
