<Window x:Class="FreshExile.App.MapRegexWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FreshExile.App"
        Title="{l:T 'Fresh Exile · regex карт'}" Width="500" Height="760" MinHeight="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- a row's two picks: a red cross to avoid the mod, a green tick to want it -->
        <Style x:Key="PickToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="{StaticResource FsCaption}"/>
            <Setter Property="Foreground" Value="{StaticResource Text3}"/>
            <Setter Property="Tag" Value="{StaticResource Ok}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" CornerRadius="{StaticResource RadiusS}" BorderThickness="1" BorderBrush="{StaticResource Line}" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource HoverBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text2}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ContentControl Style="{StaticResource WindowFrame}">
        <DockPanel>
            <!-- header: drag to move, the cross gives the game its focus back -->
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" CornerRadius="9,9,0,0" MouseLeftButtonDown="Drag_MouseDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{StaticResource Surface2Color}" Offset="0"/>
                        <GradientStop Color="{StaticResource PanelColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="16,12,8,10" Background="Transparent">
                    <StackPanel>
                        <TextBlock Text="Regex" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FsCaption}" Foreground="{StaticResource Bronze}"/>
                        <TextBlock Text="{l:T 'Поиск карт'}" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FsTitle}" FontWeight="Bold"
                                   Foreground="{StaticResource TitleText}" Margin="0,1,0,0"/>
                        <TextBlock Text="{l:T 'Строка для поиска в тайнике и в устройстве карт: отметь, чего избегать и что нужно'}"
                                   Foreground="{StaticResource Text3}" FontSize="{StaticResource FsSmall}" TextWrapping="Wrap" Margin="0,2,40,0"/>
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="{StaticResource FsCaption}" ToolTip="{l:T 'Закрыть · Esc'}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- the string: always in view, copy with one click -->
            <Border DockPanel.Dock="Top" Margin="14,12,14,0" Background="{StaticResource Well}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusM}" Padding="10,8">
                <StackPanel>
                    <TextBox Text="{Binding Result, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource Text}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FsSmall}"
                             CaretBrush="{StaticResource Text}" SelectionBrush="{StaticResource Selection}" MinHeight="34" MaxHeight="90"
                             VerticalScrollBarVisibility="Auto"/>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding LengthText}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FsSmall}"
                                   VerticalAlignment="Center" ToolTip="{l:T 'Поиск в игре берёт не больше 250 символов'}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Text3}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TooLong}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DangerLine}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButton}" Content="{l:T 'Сбросить'}" Command="{Binding ResetCommand}" Margin="0,0,8,0" Padding="12,5"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="{l:T 'Копировать'}" Command="{Binding CopyCommand}" Padding="16,5"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding Status}" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource Ok}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding HasStatus, Converter={StaticResource Vis}}"/>
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,10">
                <StackPanel Margin="14,0,14,0">
                    <!-- the property block's totals -->
                    <TextBlock Text="{l:T 'НЕ МЕНЬШЕ, %'}" Style="{StaticResource Caption}" Margin="2,4,0,6"/>
                    <ItemsControl ItemsSource="{Binding Totals}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,10,6">
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource Field}" Width="46" Padding="4,5" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                             HorizontalContentAlignment="Center"/>
                                    <TextBlock Text="{Binding Label}" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource Text2}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" Margin="0,0,6,0"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- the map itself -->
                    <TextBlock Text="{l:T 'КАРТА'}" Style="{StaticResource Caption}" Margin="2,10,0,6"/>
                    <WrapPanel>
                        <l:TriSegment Label="{l:T 'Коррапт'}" Value="{Binding Corrupted}" Margin="0,0,20,6"/>
                        <l:TriSegment Label="{l:T 'Неопознана'}" Value="{Binding Unidentified}" Margin="0,0,20,6"/>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{l:T 'Редкость'}" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ToggleButton Style="{StaticResource Chip}" Content="{l:T 'Обычная'}" IsChecked="{Binding Normal}" Margin="0,0,6,0"/>
                        <ToggleButton Style="{StaticResource Chip}" Content="{l:T 'Магическая'}" IsChecked="{Binding Magic}" Margin="0,0,6,0"/>
                        <ToggleButton Style="{StaticResource Chip}" Content="{l:T 'Редкая'}" IsChecked="{Binding Rare}"/>
                    </StackPanel>

                    <!-- the mods -->
                    <DockPanel Margin="2,16,0,6">
                        <Border DockPanel.Dock="Right" Background="{StaticResource Surface}" CornerRadius="{StaticResource RadiusM}" Padding="2"
                                ToolTip="{l:T 'Нужны все отмеченные моды сразу или хватит любого из них'}">
                            <UniformGrid Columns="2" Width="150">
                                <RadioButton Style="{StaticResource Segment}" GroupName="want" Content="{l:T 'все'}" IsChecked="{Binding WantAll}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="want" Content="{l:T 'любой'}" IsChecked="{Binding WantAny}"/>
                            </UniformGrid>
                        </Border>
                        <TextBlock DockPanel.Dock="Right" Text="{l:T 'нужны:'}" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource Text3}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="{l:T 'МОДЫ'}" FontWeight="SemiBold" Foreground="{StaticResource Text3}" FontSize="{StaticResource FsCaption}"/><Run Text="   "/><Run
                                 Text="{Binding AvoidCaption, Mode=OneWay}" Foreground="{StaticResource DangerLine}" FontSize="{StaticResource FsCaption}"/><Run Text="  ·  "
                                 Foreground="{StaticResource Text3}"/><Run Text="{Binding WantCaption, Mode=OneWay}" Foreground="{StaticResource Ok}" FontSize="{StaticResource FsCaption}"/>
                        </TextBlock>
                    </DockPanel>
                    <TextBox Style="{StaticResource Field}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" Tag="{l:T 'Найти мод: hexproof, regenerate, delirium…'}"
                             ToolTip="{l:T 'Найти мод по тексту'}"/>
                    <DockPanel Margin="0,0,0,8">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Chip}" Content="{l:T 'Только отмеченные'}" IsChecked="{Binding PickedOnly}"/>
                        <Border Background="{StaticResource Surface}" CornerRadius="{StaticResource RadiusM}" Padding="2" HorizontalAlignment="Left" Margin="0,0,8,0">
                            <UniformGrid Columns="3" Width="210">
                                <RadioButton Style="{StaticResource Segment}" GroupName="tier" Content="{l:T 'все'}" IsChecked="{Binding TierAll}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="tier" Content="T1–16" IsChecked="{Binding TierRegular}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="tier" Content="T17" IsChecked="{Binding TierUber}"/>
                            </UniformGrid>
                        </Border>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding View}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="row" Background="Transparent" CornerRadius="{StaticResource RadiusM}" Padding="4,5" Margin="0,0,0,1" ToolTip="{Binding Tip}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton Style="{StaticResource PickToggle}" Content="&#xE711;" Tag="{StaticResource Danger}" IsChecked="{Binding IsAvoid}"
                                                      ToolTip="{l:T 'Избегать: карта с этим модом не подсветится'}" VerticalAlignment="Top"/>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource PickToggle}" Content="&#xE73E;" IsChecked="{Binding IsWant}" Margin="4,0,10,0"
                                                      ToolTip="{l:T 'Нужен: подсветится карта с этим модом'}" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Text}" FontSize="{StaticResource FsSmall}" TextWrapping="Wrap" Foreground="{StaticResource Text2}" x:Name="text"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                <TextBlock Text="T17" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource RarityUnique}" Margin="0,0,8,0"
                                                           Visibility="{Binding IsUber, Converter={StaticResource Vis}}"/>
                                                <TextBlock Text="{Binding KindText}" FontSize="10" Foreground="{StaticResource Text3}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="row" Property="Background" Value="{StaticResource Surface}"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsAvoid}" Value="True">
                                        <Setter TargetName="text" Property="Foreground" Value="{StaticResource DangerText}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsWant}" Value="True">
                                        <Setter TargetName="text" Property="Foreground" Value="{StaticResource Text}"/>
                                        <Setter TargetName="row" Property="Background" Value="{StaticResource AccentFaint}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- saved sets: a click loads one -->
                    <TextBlock Text="{l:T 'НАБОРЫ'}" Style="{StaticResource Caption}" Margin="2,16,0,6"/>
                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="{StaticResource RadiusM}" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding Name}" Style="{StaticResource SmallButton}" BorderThickness="0" Background="Transparent"
                                                Command="{Binding DataContext.LoadPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                ToolTip="{l:T 'Загрузить набор'}"/>
                                        <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="9" Width="22" Height="22"
                                                Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                ToolTip="{l:T 'Удалить набор'}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{l:T 'Сохранить'}" Command="{Binding SavePresetCommand}"
                                Margin="8,0,0,0" Padding="12,5"/>
                        <TextBox Style="{StaticResource Field}" Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" Tag="{l:T 'Имя нового набора'}"
                                 ToolTip="{l:T 'Имя набора: тот же снова — перезапишет'}"/>
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </ContentControl>
</Window>
