<Window x:Class="FreshExile.App.TreeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FreshExile.App"
        xmlns:local="clr-namespace:FreshExile.App"
        Title="{l:T 'Fresh Exile · дерево'}" Width="1180" Height="780" MinWidth="460" MinHeight="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        UseLayoutRounding="True">

    <Border x:Name="Frame" CornerRadius="{StaticResource RadiusL}" BorderThickness="1" BorderBrush="{StaticResource Line}">
        <Border.Background>
            <SolidColorBrush Color="{StaticResource TreeBgColor}" Opacity="{Binding TreeBgOpacity}"/>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- toolbar -->
            <Border x:Name="Toolbar" Margin="8,8,8,0" Padding="14,6,6,6" CornerRadius="{StaticResource RadiusM}" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineStrong}" BorderThickness="1" MouseLeftButtonDown="Drag_MouseDown"
                    Visibility="{Binding TreeClickThrough, Converter={StaticResource NotVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="{l:T 'Дерево этапа'}" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FsCaption}" Foreground="{StaticResource Bronze}"/>
                        <TextBlock Text="{Binding StageTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FsTitle}" FontWeight="Bold"
                                   Foreground="{StaticResource TitleText}" Margin="0,-2,0,0"/>
                    </StackPanel>

                    <WrapPanel Grid.Column="1" Margin="24,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal" Margin="0,2,18,2">
                            <Border MinWidth="18" Height="18" CornerRadius="9" Background="{StaticResource Accent}" Padding="4,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PointsToTake}" FontSize="{StaticResource FsCaption}" FontWeight="Bold" Foreground="{StaticResource OnAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{l:T 'взять'}" Margin="7,0,0,0" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource Text2}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,18,2">
                            <Ellipse Fill="{StaticResource Text2}" Width="10" Height="10" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:T 'уже взято'}" Margin="7,0,0,0" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource Text2}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,18,2">
                            <Ellipse Width="12" Height="12" Stroke="{StaticResource SocketR}" StrokeThickness="2" VerticalAlignment="Center"/>
                            <TextBlock Margin="7,0,0,0" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource Text2}" VerticalAlignment="Center">
                                <Run Text="{l:T 'снять'}"/><Run Text="{Binding RefundCount, Mode=OneWay, StringFormat=' · {0}'}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,18,2" Visibility="{Binding HasAscendancy, Converter={StaticResource Vis}}">
                            <Path Data="M5,0.5 L9.5,5 L5,9.5 L0.5,5 Z" Width="10" Height="10" Stretch="None" Stroke="{StaticResource Text}"
                                  StrokeThickness="1.2" StrokeLineJoin="Round" VerticalAlignment="Center"/>
                            <TextBlock Margin="6,0,0,0" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource Text2}" VerticalAlignment="Center">
                                <Run Text="{l:T 'Асценд.'}"/> <Run Text="{Binding AscendancyCount, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </WrapPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{l:T 'Сравнить с'}" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Border Background="{StaticResource Well}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="{StaticResource RadiusM}" Padding="2" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="tcmp" Width="118" Content="{l:T 'прошлым этапом'}" FontSize="{StaticResource FsSmall}"
                                             IsChecked="{Binding CompareWithPrevious}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="tcmp" Width="96" Content="{l:T 'персонажем'}" FontSize="{StaticResource FsSmall}"
                                             IsChecked="{Binding CompareWithCharacter}"/>
                            </StackPanel>
                        </Border>
                        <Border Width="1" Height="28" Background="{StaticResource Line}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:T 'Фон'}" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider Style="{StaticResource Thin}" Width="84" Minimum="0" Maximum="1" Value="{Binding TreeBgOpacity}"
                                VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{l:T 'Прозрачность фона: 0 = только линии поверх игрового дерева'}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE71F;" ToolTip="{l:T 'Приблизить'}" Click="ZoomIn_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE71E;" ToolTip="{l:T 'Отдалить'}" Click="ZoomOut_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE9A6;" ToolTip="{l:T 'Показать план этапа'}" Click="Fit_Click"/>
                        <ToggleButton Style="{StaticResource IconToggle}" Content="&#xE7C9;" IsChecked="{Binding TreeClickThrough}"
                                      ToolTip="{Binding TipThrough}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="{StaticResource FsCaption}" ToolTip="{Binding TipHideTree}" Click="Hide_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <local:TreeCanvas x:Name="Canvas" Margin="1,4,1,1"/>

                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource PanelBrush}" CornerRadius="{StaticResource RadiusM}" Padding="14,9"
                        Visibility="{Binding HasTreeHint, Converter={StaticResource Vis}}" IsHitTestVisible="False">
                    <TextBlock Text="{Binding TreeHint}" Foreground="{StaticResource Text2}"/>
                </Border>

                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Padding="10,5" CornerRadius="{StaticResource RadiusM}"
                        Background="{StaticResource PanelBrush}" IsHitTestVisible="False"
                        Visibility="{Binding TreeClickThrough, Converter={StaticResource Vis}}">
                    <TextBlock FontSize="{StaticResource FsSmall}" Foreground="{StaticResource Text2}">
                        <Run Text="{Binding KeyThrough, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource Text}"/> <Run Text="{l:T 'вернуть управление'}"/>
                    </TextBlock>
                </Border>

                <!-- how to drive it: the keys bright, the rest quiet -->
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,26,12" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource Text2}"
                           IsHitTestVisible="False" Visibility="{Binding TreeClickThrough, Converter={StaticResource NotVis}}">
                    <Run Text="{l:T 'Колесо'}" Foreground="{StaticResource Text}" FontWeight="SemiBold"/><Run Text="{l:T ' — масштаб · '}"/><Run
                         Text="{l:T 'ЛКМ'}" Foreground="{StaticResource Text}" FontWeight="SemiBold"/><Run Text="{l:T ' — двигать · '}"/><Run
                         Text="{l:T 'Наведи'}" Foreground="{StaticResource Text}" FontWeight="SemiBold"/><Run Text="{l:T ' на узел — описание'}"/>
                </TextBlock>

                <Canvas IsHitTestVisible="False">
                    <Border x:Name="Tip" Visibility="Collapsed" Background="{StaticResource Surface2}" BorderBrush="{StaticResource LineStrong}"
                            BorderThickness="1" CornerRadius="{StaticResource RadiusM}" Padding="12,9" MaxWidth="340">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TipTitle" FontSize="{StaticResource FsBody}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <Border x:Name="TipStepBox" Grid.Column="1" Background="{StaticResource Accent}" CornerRadius="{StaticResource RadiusS}" Padding="6,1" Margin="10,0,0,0"
                                        VerticalAlignment="Top">
                                    <TextBlock x:Name="TipStep" FontSize="{StaticResource FsCaption}" FontWeight="Bold" Foreground="{StaticResource OnAccent}"/>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="TipKind" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                            <TextBlock x:Name="TipStats" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource Text2}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="17"/>
                        </StackPanel>
                    </Border>
                </Canvas>
            </Grid>
        </Grid>
    </Border>
</Window>
