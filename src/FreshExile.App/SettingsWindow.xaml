<Window x:Class="FreshExile.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FreshExile.App"
        Title="{l:T 'Fresh Exile · настройки'}" Width="760" Height="620" MinWidth="620" MinHeight="420" Icon="app.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        UseLayoutRounding="True">

    <!-- a settings window of its own: opened rarely, so the overlay panel keeps only what is played with -->
    <Window.Resources>
        <!-- a section in the menu on the left -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="GroupName" Value="section"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="12,7">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Surface3}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text3}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="16"/>
            <Setter Property="Margin" Value="2,6,0,0"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource LineStrong}" CornerRadius="12" Padding="1" UseLayoutRounding="False">
    <Border Background="{StaticResource PanelBrush}" CornerRadius="11">
        <Grid UseLayoutRounding="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- menu -->
            <Border Background="{StaticResource Surface}" CornerRadius="11,0,0,11" MouseLeftButtonDown="Drag_MouseDown">
                <DockPanel Margin="12,14,12,14">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,18" IsHitTestVisible="False">
                        <Image Source="logo.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="FRESH EXILE" Style="{StaticResource Caption}" FontSize="9.5"/>
                            <TextBlock Text="{l:T 'Настройки'}" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding AppVersionText}" Foreground="{StaticResource Text3}" FontSize="11" Margin="12,8,0,0"/>
                    <StackPanel>
                        <RadioButton Style="{StaticResource NavItem}" Content="{l:T 'Общие'}" IsChecked="{Binding IsSetGame}"/>
                        <RadioButton Style="{StaticResource NavItem}" Content="{l:T 'Отслеживание'}" IsChecked="{Binding IsSetTracking}"/>
                        <RadioButton Style="{StaticResource NavItem}" Content="{l:T 'Билд и этапы'}" IsChecked="{Binding IsSetBuild}"/>
                        <RadioButton Style="{StaticResource NavItem}" Content="{l:T 'Дерево'}" IsChecked="{Binding IsSetTree}"/>
                        <RadioButton Style="{StaticResource NavItem}" Content="{l:T 'Трейд'}" IsChecked="{Binding IsSetTrade}"/>
                        <RadioButton Style="{StaticResource NavItem}" Content="{l:T 'Прайс-чек'}" IsChecked="{Binding IsSetPrice}"/>
                        <RadioButton Style="{StaticResource NavItem}" Content="{l:T 'Топ-моды'}" IsChecked="{Binding IsSetTop}"/>
                        <RadioButton Style="{StaticResource NavItem}" Content="{l:T 'Клавиши'}" IsChecked="{Binding IsSetKeys}"/>
                        <RadioButton Style="{StaticResource NavItem}" Content="{l:T 'О программе'}" IsChecked="{Binding IsSetAbout}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- section -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="26,16,10,0" Background="Transparent" MouseLeftButtonDown="Drag_MouseDown">
                    <TextBlock Text="{Binding SettingsSectionTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                            ToolTip="{l:T 'Закрыть · Esc'}" Click="Close_Click"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,4,14">
                    <StackPanel Margin="26,0,22,8">

                        <!-- general -->
                        <StackPanel Visibility="{Binding IsSetGame, Converter={StaticResource Vis}}">
                            <TextBlock Text="{l:T 'ЯЗЫК'}" Style="{StaticResource Caption}" Margin="0,4,0,8"/>
                            <Border Background="{StaticResource Surface}" CornerRadius="10" Padding="3" Width="260" HorizontalAlignment="Left">
                                <UniformGrid Rows="1">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="lang" Content="Русский" FontSize="11.5" IsChecked="{Binding IsLangRu}"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="lang" Content="English" FontSize="11.5" IsChecked="{Binding IsLangEn}"/>
                                </UniformGrid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="2,8,0,0" Visibility="{Binding LanguagePending, Converter={StaticResource Vis}}">
                                <TextBlock Text="{l:T 'Язык сменится после перезапуска'}" FontSize="11.5" Foreground="{StaticResource Text3}" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="{l:T 'Перезапустить'}" Padding="10,4" FontSize="11.5" Margin="12,0,0,0"
                                        Command="{Binding RestartCommand}"/>
                            </StackPanel>

                            <TextBlock Text="{l:T 'МАСШТАБ ИНТЕРФЕЙСА'}" Style="{StaticResource Caption}" Margin="0,20,0,8"/>
                            <Border Background="{StaticResource Surface}" CornerRadius="10" Padding="3" Width="360" HorizontalAlignment="Left">
                                <ItemsControl ItemsSource="{Binding ScaleOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Style="{StaticResource Segment}" GroupName="uiscale" Content="{Binding Label}" FontSize="11.5"
                                                         IsChecked="{Binding IsChecked}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TextBlock Style="{StaticResource Hint}" Margin="2,6,0,0"
                                       Text="{l:T 'Для 1440p и 4K, если в Windows стоит масштаб 100 % и всё мелкое. Наложение на дерево в игре не меняется.'}"/>

                            <TextBlock Style="{StaticResource Hint}" Margin="2,8,0,0" Foreground="{StaticResource Accent}"
                                       Text="{l:T 'Это язык программы. Сама игра пока должна быть на английском: отслеживание зон и уровней и прайс-чек читают английские тексты игры.'}"/>

                            <TextBlock Text="{l:T 'ЛОГ ИГРЫ · CLIENT.TXT'}" Style="{StaticResource Caption}" Margin="0,24,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource Field}" Tag="…\Path of Exile\logs\Client.txt" Text="{Binding ClientLogPath}"/>
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="{l:T 'Обзор…'}" Click="Browse_Click" Margin="8,0,0,0" Padding="12,6"/>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="{l:T 'Найти сам'}" Command="{Binding DetectLogCommand}" Margin="6,0,0,0" Padding="12,6"/>
                            </Grid>
                            <TextBlock Text="{Binding LogStatus}" Style="{StaticResource Hint}"/>

                            <TextBlock Text="{l:T 'ПАНЕЛЬ'}" Style="{StaticResource Caption}" Margin="0,24,0,6"/>
                            <CheckBox Style="{StaticResource GemCheck}" IsChecked="{Binding HideWhenGameInactive}" Margin="-7,0,0,0">
                                <TextBlock Text="{l:T 'Прятать панель и дерево, когда впереди другая программа (игра запущена)'}" FontSize="12.5" TextWrapping="Wrap"/>
                            </CheckBox>
                        </StackPanel>

                        <!-- tracking: the master switch and what of it -->
                        <StackPanel Visibility="{Binding IsSetTracking, Converter={StaticResource Vis}}">
                            <Border Background="{StaticResource Surface}" CornerRadius="10" Padding="4,8,12,10" Margin="0,4,0,0">
                                <StackPanel>
                                    <CheckBox Style="{StaticResource GemCheck}" IsChecked="{Binding Tracking}">
                                        <TextBlock Text="{l:T 'Следить за игрой'}" FontSize="13.5" FontWeight="SemiBold"/>
                                    </CheckBox>
                                    <TextBlock Foreground="{StaticResource Text3}" FontSize="11.5" Margin="33,2,0,0" TextWrapping="Wrap" LineHeight="16"
                                               Text="{l:T 'Этапы сами по логу, путь на игровом дереве, панель уходит от инвентаря, подсказки нового этапа и персонажа, покупки в городе. Выключи — останется гайд: этапы листаешь сам, шмот и гемы смотришь, прайс-чек и таймер карт работают. Экран тогда не снимается совсем.'}"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="0,10,0,0" IsEnabled="{Binding Tracking}">
                                <CheckBox Style="{StaticResource GemCheck}" IsChecked="{Binding FollowGame}" Margin="-7,0,0,0">
                                    <TextBlock Text="{l:T 'Переключать этап по акту и уровню из игры'}" FontSize="12.5" TextWrapping="Wrap"/>
                                </CheckBox>
                                <CheckBox Style="{StaticResource GemCheck}" IsChecked="{Binding TrackGems}" Margin="-7,2,0,0">
                                    <TextBlock Text="{l:T 'Гемы: что купить в городе'}" FontSize="12.5" TextWrapping="Wrap"/>
                                </CheckBox>
                                <CheckBox Style="{StaticResource GemCheck}" IsChecked="{Binding TrackGemLinks}" Margin="-7,2,0,0">
                                    <TextBlock Text="{l:T 'Связки: что переставить в сокетах'}" FontSize="12.5" TextWrapping="Wrap"/>
                                </CheckBox>
                                <!-- the path on the game tree is switched in its own section, «Дерево» -->
                                <TextBlock Style="{StaticResource Hint}" Margin="26,8,0,0" Text="{l:T 'Путь на игровом дереве — в разделе «Дерево».'}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- build and stages -->
                        <StackPanel Visibility="{Binding IsSetBuild, Converter={StaticResource Vis}}">
                            <TextBlock Text="PATH OF BUILDING" Style="{StaticResource Caption}" Margin="0,4,0,8"/>
                            <TextBox Style="{StaticResource Field}" Tag="{l:T 'Ссылка pobb.in или код PoB'}" Text="{Binding BuildInput, UpdateSourceTrigger=PropertyChanged}"/>
                            <UniformGrid Rows="1" Margin="0,8,-8,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="{Binding LoadButtonText}" Command="{Binding LoadBuildCommand}" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource GhostButton}" Content="{Binding SaveStageText}" Command="{Binding SaveStageCommand}" Margin="0,0,8,0"
                                        ToolTip="{l:T 'Для PoB, который меняется по ходу игры (стример): то, что сейчас по ссылке, добавится к твоему билду новым этапом «Ур. N». Сохраняется сам билд, не ссылка: прошлые этапы не меняются.'}"/>
                            </UniformGrid>
                            <TextBlock Text="{Binding BuildError}" TextWrapping="Wrap" FontSize="12" Margin="2,8,0,0"
                                       Visibility="{Binding HasBuildError, Converter={StaticResource Vis}}"/>

                            <StackPanel Visibility="{Binding HasRecentBuilds, Converter={StaticResource Vis}}">
                                <TextBlock Text="{l:T 'НЕДАВНИЕ БИЛДЫ'}" Style="{StaticResource Caption}" Margin="0,24,0,6"/>
                                <ItemsControl ItemsSource="{Binding RecentBuilds}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Surface}" CornerRadius="8" Padding="12,7,6,7" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{StaticResource Text3}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="{l:T 'Открыть'}" Padding="12,5" Margin="8,0,4,0"
                                                            Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="9" VerticalAlignment="Center"
                                                            ToolTip="{l:T 'Убрать из списка'}"
                                                            Command="{Binding DataContext.RemoveRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Hint}" Margin="2,0,0,0"
                                           Text="{l:T 'Хранится сам билд, не только ссылка: откроется, даже если ссылка уже не работает, и с того этапа, где ты остановился.'}"/>
                            </StackPanel>

                            <TextBlock Text="{l:T 'ПЕРЕКЛЮЧЕНИЕ ЭТАПОВ'}" Style="{StaticResource Caption}" Margin="0,24,0,6"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="2,0,0,10"
                                       Text="{l:T 'С какого уровня персонажа или тира карты включается этап. Пусто = по названию (lvl 12-30, T11, Red Maps) или по акту. Работает при включённом «Авто», только вперёд.'}"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="96"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="{l:T 'УРОВЕНЬ'}" Style="{StaticResource Caption}" FontSize="9.5" Margin="2,0,0,0"/>
                                <TextBlock Grid.Column="3" Text="{l:T 'ТИР КАРТЫ'}" Style="{StaticResource Caption}" FontSize="9.5" Margin="2,0,0,0"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding StageLevelRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="96"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="96"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,10,0"/>
                                            <TextBox Grid.Column="1" Style="{StaticResource Field}" Padding="8,5" FontSize="12"
                                                     Tag="{Binding AutoText}" Text="{Binding Text}" ToolTip="{l:T 'Уровень персонажа 1–100, пусто = авто'}"/>
                                            <TextBox Grid.Column="3" Style="{StaticResource Field}" Padding="8,5" FontSize="12"
                                                     Tag="{Binding AutoTierText}" Text="{Binding TierText}" ToolTip="{l:T 'Тир карты 1–17 (T11 = красные), пусто = авто'}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{l:T 'ПЕРСОНАЖ · ПУБЛИЧНЫЙ ПРОФИЛЬ'}" Style="{StaticResource Caption}" Margin="0,24,0,8"/>
                            <UniformGrid Rows="1" Margin="0,0,-8,0">
                                <TextBox Style="{StaticResource Field}" Tag="{l:T 'Аккаунт, например Name#1234'}" Text="{Binding Account}" Margin="0,0,8,0"/>
                                <TextBox Style="{StaticResource Field}" Tag="{l:T 'Имя персонажа'}" Text="{Binding Character}" Margin="0,0,8,0"/>
                            </UniformGrid>
                            <Button Style="{StaticResource PrimaryButton}" Content="{Binding SyncButtonText}" Command="{Binding SyncCharacterCommand}" Margin="0,8,0,0"
                                    HorizontalAlignment="Left" Padding="16,7"/>
                            <TextBlock Text="{Binding CharStatus}" Foreground="{StaticResource Text2}" FontSize="11.5" Margin="2,6,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding CharError}" FontSize="12" Margin="2,6,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding HasCharError, Converter={StaticResource Vis}}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{l:T 'Отметит гемы, которые уже стоят в шмотках, и даст сравнить дерево с реальным персонажем.'}"/>
                        </StackPanel>

                        <!-- tree overlay -->
                        <StackPanel Visibility="{Binding IsSetTree, Converter={StaticResource Vis}}">
                            <TextBlock Text="{l:T 'НАЛОЖЕНИЕ НА ИГРОВОЕ ДЕРЕВО'}" Style="{StaticResource Caption}" Margin="0,4,0,6"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="2,0,0,8"
                                       Text="{l:T 'Открыл дерево (P) — панель прячется, сверху шапка, путь этапа лежит прямо на узлах, клики проходят в игру. Ищет твой уже взятый путь по снимку экрана, поэтому синхронизируй персонажа. Зум можно менять: новый масштаб подбирается сам за 1–2 с и запоминается.'}"/>
                            <CheckBox Style="{StaticResource GemCheck}" IsChecked="{Binding TreeOverlayEnabled}" Margin="-7,0,0,0" IsEnabled="{Binding Tracking}">
                                <TextBlock Text="{l:T 'Рисовать путь прямо на дереве в игре'}" FontSize="12.5" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox Style="{StaticResource GemCheck}" IsChecked="{Binding TreeOverlayInCapture}" Margin="-7,2,0,0" IsEnabled="{Binding Tracking}">
                                <TextBlock Text="{l:T 'Показывать путь на скриншотах и записи экрана'}" FontSize="12.5" TextWrapping="Wrap"/>
                            </CheckBox>
                            <TextBlock Style="{StaticResource Hint}" Margin="33,0,0,4"
                                       Text="{l:T 'Для видео, если путь съезжает. Пока включено, программа хуже замечает только что взятые узлы. Сбрасывается при перезапуске.'}"/>
                            <CheckBox Style="{StaticResource GemCheck}" IsChecked="{Binding ClusterCardFull}" Margin="-7,6,0,0">
                                <TextBlock Text="{l:T 'Карточка джевела: все моды, а не только ноталки'}" FontSize="12.5" TextWrapping="Wrap"/>
                            </CheckBox>
                            <TextBlock Text="{Binding ScaleInfo}" Foreground="{StaticResource Text2}" FontSize="11.5" Margin="2,10,0,0" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource GhostButton}" Content="{l:T 'Откалибровать масштаб заново'}" Command="{Binding RecalibrateCommand}" Margin="0,8,0,0"
                                    HorizontalAlignment="Left" Padding="14,7" IsEnabled="{Binding Tracking}"/>

                            <TextBlock Text="{l:T 'ДАННЫЕ ДЕРЕВА'}" Style="{StaticResource Caption}" Margin="0,24,0,8"/>
                            <Button Style="{StaticResource GhostButton}" Content="{l:T 'Обновить данные дерева'}" Command="{Binding RefreshTreeCommand}"
                                    HorizontalAlignment="Left" Padding="14,7"/>
                            <TextBlock Text="{Binding TreeInfo}" Style="{StaticResource Hint}"/>
                        </StackPanel>

                        <!-- trade search, shared by the gear and gem buttons and the price check -->
                        <StackPanel Visibility="{Binding IsSetTrade, Converter={StaticResource Vis}}">
                            <TextBlock Style="{StaticResource Hint}" Margin="2,0,0,12"
                                       Text="{l:T 'Общее для кнопок трейда у шмота и гемов и для прайс-чека: каких продавцов показывать и насколько строго подбирать статы. Лигу можно не трогать: берётся текущая софткор-лига.'}"/>
                            <TextBlock Text="{l:T 'ПРОДАВЦЫ'}" Style="{StaticResource Caption}" Margin="0,4,0,8"/>
                            <Border Background="{StaticResource Surface}" CornerRadius="10" Padding="3">
                                <UniformGrid Rows="1">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="tradeStatus" Content="Instant" FontSize="11.5" IsChecked="{Binding IsTradeInstant}"
                                                 ToolTip="{l:T 'Instant Buyout: только то, что покупается сразу, без переписки'}"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="tradeStatus" Content="{l:T 'Instant и лично'}" FontSize="11.5" IsChecked="{Binding IsTradeInstantOrPerson}"
                                                 ToolTip="Instant Buyout and In Person"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="tradeStatus" Content="{l:T 'Лично онлайн'}" FontSize="11.5" IsChecked="{Binding IsTradeInPerson}"
                                                 ToolTip="{l:T 'In Person (Online): продавец в игре, пишешь ему в личку'}"/>
                                </UniformGrid>
                            </Border>
                            <Grid Margin="2,18,0,0">
                                <TextBlock Text="{l:T 'Подбор статов'}" FontSize="12.5"/>
                                <TextBlock Text="{Binding TradeStrictness, StringFormat='{}{0:0}%'}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                           Foreground="{StaticResource Text2}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider Style="{StaticResource Thin}" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                    SmallChange="5" LargeChange="10" Value="{Binding TradeStrictness}" Margin="0,6,0,0"
                                    ToolTip="{l:T 'Минимумы статов в поиске: доля от роллов в PoB. Правее строже, левее больше находится'}"/>
                            <TextBlock Text="{Binding TradeStrictnessText}" Style="{StaticResource Hint}" Margin="2,4,0,0"/>
                            <TextBlock Text="{l:T 'ЛИГА'}" Style="{StaticResource Caption}" Margin="0,22,0,8"/>
                            <TextBox Style="{StaticResource Field}" Tag="{l:T 'Лига (пусто = текущая)'}" Text="{Binding TradeLeagueInput}" Width="260" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- price check -->
                        <StackPanel Visibility="{Binding IsSetPrice, Converter={StaticResource Vis}}">
                            <TextBlock Style="{StaticResource Hint}" Margin="2,0,0,12" Text="{Binding PriceHint}"/>
                            <TextBlock Text="{l:T 'Валюта цены'}" FontSize="12.5" Margin="2,0,0,6"/>
                            <Border Background="{StaticResource Surface}" CornerRadius="10" Padding="3">
                                <UniformGrid Rows="1">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="priceCur" Content="{l:T 'Любая'}" FontSize="11.5" IsChecked="{Binding IsPriceAnyCurrency}"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="priceCur" Content="Chaos" FontSize="11.5" IsChecked="{Binding IsPriceChaos}"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="priceCur" Content="Divine" FontSize="11.5" IsChecked="{Binding IsPriceDivine}"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="priceCur" Content="Chaos/Div" FontSize="11.5" IsChecked="{Binding IsPriceChaosDivine}"
                                                 ToolTip="{l:T 'Только цены в chaos или divine: без странных валют'}"/>
                                </UniformGrid>
                            </Border>
                            <TextBlock Text="{l:T 'Выставлено'}" FontSize="12.5" Margin="2,14,0,6"/>
                            <Border Background="{StaticResource Surface}" CornerRadius="10" Padding="3">
                                <UniformGrid Rows="1">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="priceListed" Content="{l:T 'Когда угодно'}" FontSize="11.5" IsChecked="{Binding IsListedAny}"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="priceListed" Content="{l:T 'За день'}" FontSize="11.5" IsChecked="{Binding IsListedDay}"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="priceListed" Content="{l:T '3 дня'}" FontSize="11.5" IsChecked="{Binding IsListed3Days}"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="priceListed" Content="{l:T 'Неделя'}" FontSize="11.5" IsChecked="{Binding IsListedWeek}"/>
                                </UniformGrid>
                            </Border>
                            <CheckBox Style="{StaticResource GemCheck}" IsChecked="{Binding PriceCollapse}" Margin="-7,12,0,0">
                                <TextBlock Text="{l:T 'Одна строка на продавца'}" FontSize="12.5" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox Style="{StaticResource GemCheck}" IsChecked="{Binding PriceAutoSearch}" Margin="-7,2,0,0">
                                <TextBlock Text="{l:T 'Искать сразу, как откроется окно'}" FontSize="12.5" TextWrapping="Wrap"/>
                            </CheckBox>
                        </StackPanel>

                        <!-- top mods: the star of the comparison window, a list per slot -->
                        <StackPanel Visibility="{Binding IsSetTop, Converter={StaticResource Vis}}">
                            <TextBlock Style="{StaticResource Hint}" Margin="2,0,0,12"
                                       Text="{l:T 'Строка со звёздочкой, если в её тексте есть фраза из списка слота (# — любое число, регистр не важен) и её тир в верхней части тиров этого мода на этой базе (данные игры, RePoE). «Всегда» — для любого слота и тира: +1 к зарядам, уровни гемов, иммунитеты.'}"/>
                            <ItemsControl ItemsSource="{Binding TopSlots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource Chip}" GroupName="topSlot" Content="{Binding Name}" Padding="8,4" Margin="0,0,5,5"
                                                     IsChecked="{Binding IsSelected}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox Style="{StaticResource Field}" FontSize="12" FontFamily="{StaticResource MonoFont}" Padding="8,6" Margin="0,4,0,0"
                                     AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" MinHeight="140" MaxHeight="260"
                                     VerticalScrollBarVisibility="Auto" Text="{Binding TopModsText}" Tag="{l:T 'одна фраза на строку'}"/>
                            <Grid Margin="0,6,0,0">
                                <TextBlock Text="{l:T 'Список сохраняется, когда уходишь из поля'}" Foreground="{StaticResource Text3}" FontSize="11" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource GhostButton}" Content="{l:T 'Сбросить слот'}" Padding="10,4" FontSize="11.5" HorizontalAlignment="Right"
                                        Command="{Binding ResetTopModsCommand}" IsEnabled="{Binding TopModsEdited}"/>
                            </Grid>
                            <TextBlock Text="{l:T 'Тир мода слота'}" FontSize="12.5" Margin="2,14,0,6"/>
                            <Border Background="{StaticResource Surface}" CornerRadius="10" Padding="3">
                                <UniformGrid Rows="1">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="topTier" Content="{l:T 'Верхняя треть'}" FontSize="11.5" IsChecked="{Binding IsTopThird}"
                                                 ToolTip="{l:T 'Жизнь на перчатках: 9 тиров → T1–T3; мод с 2 тирами → только T1'}"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="topTier" Content="{l:T 'Половина'}" FontSize="11.5" IsChecked="{Binding IsTopHalf}"
                                                 ToolTip="{l:T 'Жизнь на перчатках: 9 тиров → T1–T5'}"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="topTier" Content="{l:T 'Любой'}" FontSize="11.5" IsChecked="{Binding IsTopAnyTier}"/>
                                </UniformGrid>
                            </Border>
                            <TextBlock Style="{StaticResource Hint}" Margin="2,4,0,0" FontSize="11"
                                       Text="{l:T 'Если число тиров мода неизвестно (крафт, влияние), считается как 6: треть = T1–T2.'}"/>
                        </StackPanel>

                        <!-- hotkeys -->
                        <StackPanel Visibility="{Binding IsSetKeys, Converter={StaticResource Vis}}">
                            <TextBlock Style="{StaticResource Hint}" Margin="2,0,0,12"
                                       Text="{l:T 'Нажми на кнопку и затем сочетание с Ctrl или Alt. Esc — отмена, Backspace — снять.'}"/>
                            <ItemsControl ItemsSource="{Binding HotkeyRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,10,0"/>
                                                <Button x:Name="cap" Grid.Column="1" Style="{StaticResource GhostButton}" MinWidth="150" Padding="10,6"
                                                        Command="{Binding DataContext.BeginCaptureCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="Normal"/>
                                                </Button>
                                            </Grid>
                                            <TextBlock Text="{Binding Error}" FontSize="11.5" Margin="2,4,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding HasError, Converter={StaticResource Vis}}"/>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                <Setter TargetName="cap" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource GhostButton}" Content="{l:T 'Сбросить клавиши по умолчанию'}" Command="{Binding ResetHotkeysCommand}" Margin="0,6,0,0"
                                    HorizontalAlignment="Left" Padding="14,7"/>
                        </StackPanel>

                        <!-- about: the bug report and what the program may touch -->
                        <StackPanel Visibility="{Binding IsSetAbout, Converter={StaticResource Vis}}">
                            <TextBlock Text="{l:T 'ОБНОВЛЕНИЯ'}" Style="{StaticResource Caption}" Margin="0,4,0,8"/>
                            <CheckBox Style="{StaticResource GemCheck}" IsChecked="{Binding AutoUpdate}" Margin="-7,0,0,0">
                                <TextBlock Text="{l:T 'Обновляться автоматически'}" FontSize="12.5" TextWrapping="Wrap"/>
                            </CheckBox>
                            <TextBlock Style="{StaticResource Hint}" Margin="33,0,0,6"
                                       Text="{l:T 'Новая версия скачивается с GitHub и встаёт на место exe при выходе из программы. Настройки и билд сохраняются.'}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource GhostButton}" Content="{l:T 'Проверить сейчас'}" Command="{Binding CheckUpdateCommand}" Padding="14,7"/>
                                <Button Style="{StaticResource GhostButton}" Content="{l:T 'Перезапустить'}" Command="{Binding RestartCommand}" Padding="14,7" Margin="8,0,0,0"
                                        Visibility="{Binding UpdateReady, Converter={StaticResource Vis}}"/>
                                <Button Style="{StaticResource GhostButton}" Content="{l:T 'Страница релиза'}" Command="{Binding OpenReleaseCommand}" Padding="14,7" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding UpdateStatus}" Foreground="{StaticResource Text2}" FontSize="11.5" Margin="2,6,0,0" TextWrapping="Wrap"/>

                            <TextBlock Text="{l:T 'ОТЧЁТ ОБ ОШИБКЕ'}" Style="{StaticResource Caption}" Margin="0,24,0,8"/>
                            <Button Style="{StaticResource GhostButton}" Content="{l:T 'Сохранить отчёт на рабочий стол'}" Click="Report_Click"
                                    HorizontalAlignment="Left" Padding="14,7"/>
                            <CheckBox Style="{StaticResource GemCheck}" IsChecked="{Binding ReportWithFrames}" Margin="-7,8,0,0">
                                <TextBlock Text="{l:T 'Приложить скриншоты наложения дерева'}" FontSize="12.5" TextWrapping="Wrap"/>
                            </CheckBox>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{l:T 'Zip с логом и настройками. Аккаунт, имя персонажа и имя пользователя Windows в путях заменены. Скриншоты — только с галочкой: на них может попасть чат с чужими никами.'}"/>

                            <TextBlock Text="{l:T 'ЧТО ПРОГРАММА ДЕЛАЕТ С ИГРОЙ'}" Style="{StaticResource Caption}" Margin="0,24,0,2"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{l:T 'Только разрешённое: читает Client.txt и публичный профиль, рисует своё окно поверх игры. В память игры не лезет. Единственное нажатие в игру — Ctrl+Alt+C (скопировать предмет) на одно нажатие прайс-чека. Игра должна быть в режиме Windowed Fullscreen.'}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- toast: "отчёт на рабочем столе" and the like, the same as on the panel -->
                <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,0,16,18"
                        Background="{StaticResource Accent}" CornerRadius="8" Padding="14,8" IsHitTestVisible="False"
                        Visibility="{Binding IsToastVisible, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding ToastText}" Foreground="{StaticResource OnAccent}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
    </Border>
</Window>
