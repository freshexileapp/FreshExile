<Window x:Class="FreshExile.App.TreeHeaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FreshExile.App"
        xmlns:local="clr-namespace:FreshExile.App"
        Title="{l:T 'Fresh Exile · шапка'}" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        UseLayoutRounding="True">

  <StackPanel>
    <!-- outline as two filled layers: even corners (a stroked rounded border fades on the arcs) -->
    <Border Background="{StaticResource LineStrong}" CornerRadius="{StaticResource RadiusM}" Padding="1" UseLayoutRounding="False" HorizontalAlignment="Stretch">
    <Border Background="{StaticResource PanelBrush}" CornerRadius="{StaticResource RadiusM}" Padding="9,5,5,5" MouseLeftButtonDown="Drag_MouseDown">
        <StackPanel UseLayoutRounding="True" Orientation="Horizontal">
            <Image Source="logo.png" Width="26" Height="26" VerticalAlignment="Center" IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <StackPanel Margin="10,0,6,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="{Binding StageNumberText}" Style="{StaticResource Caption}" FontSize="{StaticResource FsCaption}"/>
                <TextBlock Text="{Binding StageTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FsSection}" FontWeight="Bold"/>
            </StackPanel>
            <Button Style="{StaticResource IconButton}" Width="26" Height="26" Content="&#xE76B;" Command="{Binding PrevCommand}" ToolTip="{Binding TipPrev}"/>
            <Button Style="{StaticResource IconButton}" Width="26" Height="26" Content="&#xE76C;" Command="{Binding NextCommand}" ToolTip="{Binding TipNext}"/>

            <Border Width="1" Height="26" Background="{StaticResource Line}" Margin="8,0" VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                <Ellipse Width="11" Height="11" Stroke="{StaticResource White}" StrokeThickness="1.6" VerticalAlignment="Center"/>
                <TextBlock Margin="7,0,0,0" FontSize="{StaticResource FsSmall}" VerticalAlignment="Center">
                    <Run Text="{l:T 'Взять'}"/> <Run Text="{Binding PointsToTake, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
                <!-- the status; "path not found, zoom out" in the accent colour and bold, so an empty tree does not read as broken -->
                <!-- a steady width: the header is sized to its content and would twitch with every new status -->
                <TextBlock Text="{Binding AlignStatus}" FontSize="{StaticResource FsSmall}" Margin="14,0,6,0" VerticalAlignment="Center" MinWidth="110">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Text3}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AlignWarning}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <Button Style="{StaticResource IconButton}" Width="26" Height="26" Content="&#xE72C;" FontSize="{StaticResource FsCaption}"
                    ToolTip="{l:T 'Откалибровать масштаб заново (если менял зум дерева)'}" Click="Recalibrate_Click"/>
            <Button Style="{StaticResource IconButton}" Width="26" Height="26" Content="&#xE8BB;" FontSize="{StaticResource FsCaption}"
                    ToolTip="{l:T 'Выключить наложение (включается в настройках)'}" Click="Off_Click"/>
        </StackPanel>
    </Border>
    </Border>

    <!-- what each numbered node on the tree gives -->
    <Border Background="{StaticResource Line}" CornerRadius="{StaticResource RadiusM}" Padding="1" UseLayoutRounding="False" Margin="0,6,0,0" MaxWidth="460" HorizontalAlignment="Stretch"
            Visibility="{Binding HasPlanSteps, Converter={StaticResource Vis}}">
    <Border Background="{StaticResource PanelBrush}" CornerRadius="{StaticResource RadiusM}" Padding="5,7,7,5">
        <StackPanel UseLayoutRounding="True">
            <TextBlock Text="{Binding StepsCaption}" Style="{StaticResource Caption}" FontSize="{StaticResource FsCaption}" Margin="4,0,0,6"
                       IsHitTestVisible="False"/>
            <ItemsControl ItemsSource="{Binding PlanSteps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="row" CornerRadius="{StaticResource RadiusS}" Padding="4,2,4,2" Margin="0,0,0,2" Background="Transparent"
                                MouseEnter="Step_MouseEnter" MouseLeave="Step_MouseLeave">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- same badge as on the tree -->
                            <local:StepBadge Text="{Binding Step}" IsFocus="{Binding IsNext}" VerticalAlignment="Top" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="{StaticResource FsSmall}" LineHeight="16">
                                <Run x:Name="name" Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" — " Foreground="{StaticResource Text3}"/><Run Text="{Binding Effect, Mode=OneWay}" Foreground="{StaticResource Text2}"/>
                            </TextBlock>
                        </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <!-- the first point to spend: the same colour as its ring on the tree -->
                            <DataTrigger Binding="{Binding IsNext}" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{StaticResource AccentFaint}"/>
                            </DataTrigger>
                            <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{StaticResource AccentDim}"/>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- fold / unfold: the next five points are what matters while playing -->
            <TextBlock Text="{Binding MoreSteps}" Foreground="{StaticResource Text2}" FontSize="{StaticResource FsCaption}" Margin="30,1,0,2" Cursor="Hand"
                       TextDecorations="Underline" Visibility="{Binding HasMoreSteps, Converter={StaticResource Vis}}">
                <TextBlock.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleStepsCommand}"/>
                </TextBlock.InputBindings>
            </TextBlock>
        </StackPanel>
    </Border>
    </Border>

    <!-- RuneCaption: the stage's ones and what is left for each; the colour is their ring's on the tree -->
    <Border Background="{StaticResource LineStrong}" CornerRadius="{StaticResource RadiusM}" Padding="1" UseLayoutRounding="False" Margin="0,6,0,0" MaxWidth="460"
            HorizontalAlignment="Stretch" Visibility="{Binding HasRuneSteps, Converter={StaticResource Vis}}">
    <Border Background="{StaticResource PanelBrush}" CornerRadius="{StaticResource RadiusM}" Padding="7,6,8,5">
        <StackPanel UseLayoutRounding="True">
            <StackPanel Orientation="Horizontal" Margin="2,0,0,4" IsHitTestVisible="False">
                <Ellipse Width="9" Height="9" Stroke="{StaticResource RuneColor}" StrokeThickness="2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding RuneCaption}" Style="{StaticResource Caption}" FontSize="{StaticResource FsCaption}" Foreground="{StaticResource RuneColor}"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding RuneSteps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="row" CornerRadius="{StaticResource RadiusS}" Padding="4,2,4,2" Margin="0,0,0,2" Background="Transparent"
                                MouseEnter="Step_MouseEnter" MouseLeave="Step_MouseLeave">
                            <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Step}" Foreground="{StaticResource Ok}" FontWeight="Bold" FontSize="{StaticResource FsSmall}" LineHeight="16"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="{StaticResource FsSmall}" LineHeight="16">
                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource RuneColor}"/><Run Text=" — " Foreground="{StaticResource Text3}"/><Run
                                     Text="{Binding Effect, Mode=OneWay}" Foreground="{StaticResource Text2}"/>
                            </TextBlock>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{StaticResource AccentDim}"/>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
    </Border>

    <!-- TattooCaption: the stage's ones and what is left for each; the colour is their ring's on the tree -->
    <Border Background="{StaticResource LineStrong}" CornerRadius="{StaticResource RadiusM}" Padding="1" UseLayoutRounding="False" Margin="0,6,0,0" MaxWidth="460"
            HorizontalAlignment="Stretch" Visibility="{Binding HasTattooSteps, Converter={StaticResource Vis}}">
    <Border Background="{StaticResource PanelBrush}" CornerRadius="{StaticResource RadiusM}" Padding="7,6,8,5">
        <StackPanel UseLayoutRounding="True">
            <StackPanel Orientation="Horizontal" Margin="2,0,0,4" IsHitTestVisible="False">
                <Ellipse Width="9" Height="9" Stroke="{StaticResource TattooColor}" StrokeThickness="2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding TattooCaption}" Style="{StaticResource Caption}" FontSize="{StaticResource FsCaption}" Foreground="{StaticResource TattooColor}"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding TattooSteps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="row" CornerRadius="{StaticResource RadiusS}" Padding="4,2,4,2" Margin="0,0,0,2" Background="Transparent"
                                MouseEnter="Step_MouseEnter" MouseLeave="Step_MouseLeave">
                            <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Step}" Foreground="{StaticResource Ok}" FontWeight="Bold" FontSize="{StaticResource FsSmall}" LineHeight="16"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="{StaticResource FsSmall}" LineHeight="16">
                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TattooColor}"/><Run Text=" — " Foreground="{StaticResource Text3}"/><Run
                                     Text="{Binding Effect, Mode=OneWay}" Foreground="{StaticResource Text2}"/>
                            </TextBlock>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{StaticResource AccentDim}"/>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
    </Border>
  </StackPanel>
</Window>
