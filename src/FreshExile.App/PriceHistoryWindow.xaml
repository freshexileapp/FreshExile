<Window x:Class="FreshExile.App.PriceHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FreshExile.App"
        Title="{l:T 'Fresh Exile · история'}" Width="150" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        UseLayoutRounding="True">

    <ContentControl Style="{StaticResource WindowFrame}">
        <DockPanel Margin="0,8,0,6">
            <TextBlock DockPanel.Dock="Top" Text="{l:T 'ИСТОРИЯ'}" Style="{StaticResource Caption}" FontSize="{StaticResource FsCaption}"
                       Margin="12,0,8,6" ToolTip="{l:T 'Последние проверки за эту сессию: клик открывает её снова, без нового запроса к трейду'}"/>
            <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- name · art · the answer; the open one is marked by a brighter background and a bronze edge -->
                            <Button Click="Entry_Click" Cursor="Hand" Margin="6,0,6,4" Focusable="False">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Card" Background="{StaticResource Surface}" BorderBrush="Transparent" BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusM}" Padding="6,5">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource HoverBorder}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="{StaticResource Surface2}"/>
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BronzeLine}"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Foreground="{Binding RarityBrush}" FontSize="{StaticResource FsCaption}"
                                               TextAlignment="Center" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                    <Grid Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Listings[0].Icon, FallbackValue={x:Null}}" Width="30" Height="30" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding HistoryPrice, TargetNullValue='—'}" FontSize="{StaticResource FsSmall}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Gold}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="4,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </ContentControl>
</Window>
