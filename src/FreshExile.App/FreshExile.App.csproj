<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- the Windows SDK projection: Windows.Media.Ocr reads the mercenary window's text. The output folder keeps its
         old name (bin/Release/net10.0-windows), where the app is run from -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\net10.0-windows\</OutputPath>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FreshExile.App</RootNamespace>
    <AssemblyName>FreshExile</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>0.3.14</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <!-- the app.ico 64 px frame: the logo inside the windows (an .ico in an Image takes its first, 16 px frame) -->
    <Resource Include="logo.png" />
    <!-- Alegreya SC (SIL OFL 1.1, Fonts\OFL.txt): titles, tabs, item names -->
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FreshExile.Core\FreshExile.Core.csproj" />
  </ItemGroup>

</Project>
