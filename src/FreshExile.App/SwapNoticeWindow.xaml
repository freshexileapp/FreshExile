<Window x:Class="FreshExile.App.SwapNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FreshExile.App"
        Title="{l:T 'Fresh Exile · новый этап'}" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        UseLayoutRounding="True" Cursor="Hand"
        MouseLeftButtonDown="Dismiss_Click" Opacity="0">

    <!-- one glance in a fight: new stage + what is waiting in town; details live in the panel -->
    <Border Background="{StaticResource LineStrong}" CornerRadius="8" Padding="1" UseLayoutRounding="False">
    <Border Background="{StaticResource PanelBrush}" CornerRadius="7" Padding="9,7,13,7">
        <StackPanel UseLayoutRounding="True">
            <StackPanel Orientation="Horizontal">
                <Image Source="logo.png" Width="22" Height="22" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="{Binding StageTitle}" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="{l:T 'новый этап'}" FontSize="12" Foreground="{StaticResource Text3}" Margin="8,1,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding NoticeHint}" FontSize="12" Foreground="{StaticResource Text2}" Margin="14,1,0,0" VerticalAlignment="Center"
                           Visibility="{Binding HasNoticeHint, Converter={StaticResource Vis}}"/>
            </StackPanel>
            <Border Height="2" CornerRadius="1" Background="{StaticResource Surface3}" Margin="0,7,0,0" ClipToBounds="True">
                <Border Background="{StaticResource Text2}" CornerRadius="1" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="TimerScale" ScaleX="1"/>
                    </Border.RenderTransform>
                </Border>
            </Border>
        </StackPanel>
    </Border>
    </Border>
</Window>
