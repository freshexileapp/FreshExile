<Window x:Class="FreshExile.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FreshExile.App"
        Title="Fresh Exile" Width="380" Height="740" MinWidth="320" MinHeight="180" Icon="app.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ResizeMode="CanResizeWithGrip"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- a mastery kind / runegraft / tattoo: its name, how many, the lines it grants -->
        <DataTemplate x:Key="TreePick">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="{StaticResource RadiusM}"
                    Padding="10,7,10,8" Margin="0,0,0,6">
                <StackPanel>
                    <DockPanel>
                        <!-- a runegraft / tattoo is bought: its price check from here -->
                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="{l:T 'Цена'}" VerticalAlignment="Center"
                                ToolTip="{l:T 'Прайс-чек: найти на трейде и купить'}"
                                Command="{Binding DataContext.BuyPickCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                Visibility="{Binding CanBuy, Converter={StaticResource Vis}}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="{StaticResource FsBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <Border Background="{StaticResource Ok}" CornerRadius="{StaticResource RadiusS}" Padding="5,0,5,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasCount, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding Count}" FontSize="{StaticResource FsCaption}" FontWeight="Bold" Foreground="{StaticResource OnAccent}"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Lines}" Margin="0,3,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource Text2}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Clashes}" Margin="0,3,0,0" Visibility="{Binding HasClashes, Converter={StaticResource Vis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource DangerText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="PopupBuildRow">
            <Border x:Name="row" Background="Transparent" CornerRadius="{StaticResource RadiusM}" Padding="6,5" Cursor="Hand" MouseLeftButtonUp="PopupBuild_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="pin" Text="{Binding PinGlyph}" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource Text3}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontSize="{StaticResource FsBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Details}" FontSize="{StaticResource FsCaption}" Foreground="{StaticResource Text3}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="row" Property="Background" Value="{StaticResource Surface2}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter TargetName="pin" Property="Foreground" Value="{StaticResource Accent}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- the log shows another character: offer a fresh start from stage 1 -->
        <DataTemplate x:Key="NewCharBanner">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="{StaticResource RadiusM}" Padding="10,8"
                    Visibility="{Binding HasNewCharPrompt, Converter={StaticResource Vis}}">
                <StackPanel>
                    <TextBlock Text="{Binding NewCharText}" FontSize="{StaticResource FsSmall}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{l:T 'Отметки «куплено» этого билда сбросятся.'}" FontSize="{StaticResource FsCaption}" Foreground="{StaticResource Text3}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    <UniformGrid Rows="1" Margin="0,8,-6,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="{l:T 'С этапа 1'}" Padding="10,5" Command="{Binding AcceptNewCharCommand}" Margin="0,0,6,0"/>
                        <Button Style="{StaticResource GhostButton}" Content="{l:T 'Нет, тот же'}" Padding="10,5" Command="{Binding DismissNewCharCommand}" Margin="0,0,6,0"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <ContentControl Style="{StaticResource WindowFrame}">
        <Grid UseLayoutRounding="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid x:Name="Header" Grid.Row="0" Margin="14,12,10,0" Background="Transparent" MouseLeftButtonDown="Drag_MouseDown"
                  Visibility="{Binding ShowMini, Converter={StaticResource NotVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- full: brand + class; scrolled down: one line "logo · Act 4 · 4/14 · Ур. 38" -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding Condensed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NotVis}}">
                    <Image Source="logo.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Fresh Exile" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FsCaption}" Foreground="{StaticResource Bronze}"
                                   IsHitTestVisible="False"/>
                        <!-- "Ranger · Pathfinder ▾": the builds, the PoB box and the character, without the settings -->
                        <Border x:Name="BuildSwitch" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="BuildSwitch_MouseDown" MouseLeftButtonUp="BuildSwitch_MouseUp"
                                ToolTip="{l:T 'Билды: открыть другой, вставить PoB, синхронизировать персонажа'}"
                                Visibility="{Binding HasBuild, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="BuildSwitchText" Text="{Binding BuildLine}" FontSize="{StaticResource FsBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FsCaption}" Foreground="{StaticResource Text3}"
                                           VerticalAlignment="Center" Margin="6,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding BuildLine}" FontSize="{StaticResource FsBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   IsHitTestVisible="False" Visibility="{Binding HasBuild, Converter={StaticResource NotVis}}"/>
                    </StackPanel>
                </StackPanel>
                <DockPanel VerticalAlignment="Center" LastChildFill="True"
                           Visibility="{Binding Condensed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}">
                    <Image DockPanel.Dock="Left" Source="logo.png" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- the build switcher from the folded header too -->
                        <Button Style="{StaticResource IconButton}" Content="&#xE70D;" FontSize="{StaticResource FsCaption}" Click="BuildSwitch_Click"
                                ToolTip="{l:T 'Билды: открыть другой, вставить PoB, синхронизировать персонажа'}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE76B;" FontSize="{StaticResource FsCaption}" Command="{Binding PrevCommand}" ToolTip="{Binding TipPrev}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE76C;" FontSize="{StaticResource FsCaption}" Command="{Binding NextCommand}" ToolTip="{Binding TipNext}"/>
                    </StackPanel>
                    <TextBlock Margin="8,0,6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
                        <Run Text="{Binding StageTitle, Mode=OneWay}" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FsTitle}" FontWeight="Bold"
                             Foreground="{StaticResource TitleText}"/><Run Text="  "/><Run Text="{Binding StageOfText, Mode=OneWay}" FontSize="{StaticResource FsCaption}"
                             Foreground="{StaticResource Text3}"/>
                    </TextBlock>
                </DockPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="{l:T 'Настройки'}" Click="Settings_Click"/>
                    <!-- X folds into the mini tracker; the app itself closes from the footer -->
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="{StaticResource FsCaption}" ToolTip="{l:T 'Свернуть в мини'}" Click="Collapse_Click"/>
                </StackPanel>
            </Grid>

            <!-- the build switcher: a click on "Class · Ascendancy" in the header. The open build and its character, a box for
                 a PoB link or code (Ctrl+V into the empty box loads it at once), then the pinned and the recent builds. -->
            <Popup x:Name="BuildPopup" Grid.Row="0" PlacementTarget="{Binding ElementName=Header}" Placement="Bottom" VerticalOffset="6" HorizontalOffset="-6"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="BuildPopup_Closed">
                <Border Width="{Binding BuildPopupWidth, RelativeSource={RelativeSource AncestorType=Window}}" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="{StaticResource RadiusL}" Padding="10" KeyDown="BuildPopup_KeyDown">
                    <!-- the link to the settings sits at the bottom of the switcher, which reaches down to the footer -->
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <!-- the open build -->
                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BronzeLine}" BorderThickness="1" CornerRadius="{StaticResource RadiusM}"
                                Padding="10,8,4,8" Visibility="{Binding HasCurrentRecent, Converter={StaticResource Vis}}">
                            <Grid DataContext="{Binding CurrentRecent}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FsSection}" FontWeight="Bold"
                                               Foreground="{StaticResource TitleText}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Details}" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource Text2}" TextTrimming="CharacterEllipsis"/>
                                    <!-- bandits and pantheon: a choice of the build, always at hand here -->
                                    <TextBlock Text="{Binding DataContext.ChoicesLine, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="{StaticResource FsSmall}"
                                               Foreground="{StaticResource AccentHover}" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Visibility="{Binding DataContext.HasChoices, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE72C;" FontSize="{StaticResource FsSmall}" VerticalAlignment="Center"
                                        ToolTip="{l:T 'Синхронизировать персонажа: гемы в шмотках и дерево для сравнения'}"
                                        Command="{Binding DataContext.SyncCharacterCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding CharStatus}" FontSize="{StaticResource FsCaption}" Foreground="{StaticResource Text3}" Margin="2,4,0,0" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- a link or a code -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PopupInput" Style="{StaticResource Field}" FontSize="{StaticResource FsSmall}" Padding="8,6" TextWrapping="NoWrap"
                                     Tag="{l:T 'Вставить ссылку pobb.in / pastebin или код PoB'}" Text="{Binding BuildInput, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{Binding LoadButtonText}" Command="{Binding LoadBuildCommand}"
                                    Padding="12,0" Margin="6,0,0,0" FontSize="{StaticResource FsSmall}"/>
                        </Grid>
                        <TextBlock Text="{Binding BuildError}" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource DangerText}" TextWrapping="Wrap" Margin="2,6,0,0"
                                   Visibility="{Binding HasBuildError, Converter={StaticResource Vis}}"/>

                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                            <StackPanel>
                                <l:OrnamentDivider Style="{StaticResource SectionHeader}" Text="{l:T 'Закреплённые'}" Margin="0,8,0,6"
                                                   Visibility="{Binding HasPinnedRecent, Converter={StaticResource Vis}}"/>
                                <ItemsControl ItemsSource="{Binding PinnedRecent}" ItemTemplate="{StaticResource PopupBuildRow}"/>
                                <l:OrnamentDivider Style="{StaticResource SectionHeader}" Text="{l:T 'Недавние билды'}" Margin="0,8,0,6"
                                                   Visibility="{Binding HasOtherRecent, Converter={StaticResource Vis}}"/>
                                <ItemsControl ItemsSource="{Binding OtherRecent}" ItemTemplate="{StaticResource PopupBuildRow}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Margin="2,10,0,0" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource Bronze}" Cursor="Hand"
                               Text="{l:T 'Все билды и правила этапов в настройках ›'}" MouseLeftButtonUp="PopupSettings_Click"/>
                    </Grid>
                </Border>
            </Popup>

            <!-- stage -->
            <!-- mini tracker: one line in the field, gem shopping by vendor only in town -->
            <StackPanel Grid.Row="1" Visibility="{Binding ShowMini, Converter={StaticResource Vis}}">
                <!-- logo | stage (the name trims, never the timer) | timer | buttons -->
                <!-- DockPanel, not a Grid: a Grid's Auto column under SizeToContent did not widen when the clock
                     went 0:9 -> 0:10, and the text got cut on both sides -->
                <DockPanel Margin="10,8,6,8" Background="Transparent" MouseLeftButtonDown="Drag_MouseDown" LastChildFill="True">
                    <Image DockPanel.Dock="Left" Source="logo.png" Width="24" Height="24" VerticalAlignment="Center" IsHitTestVisible="False"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="{StaticResource FsCaption}" Content="&#xE76B;" Command="{Binding PrevCommand}" ToolTip="{Binding TipPrev}"/>
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="{StaticResource FsCaption}" Content="&#xE76C;" Command="{Binding NextCommand}" ToolTip="{Binding TipNext}"/>
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="{StaticResource FsCaption}" Content="&#xE70E;" ToolTip="{l:T 'Развернуть'}" Click="Compact_Click"/>
                    </StackPanel>
                    <!-- the run clock: a bronze stopwatch (act or map in its tooltip) and the time; the time keeps a minimum width
                         so the line does not twitch every second -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,0,6,0" VerticalAlignment="Center" Background="Transparent"
                                ToolTip="{Binding RunTimerTip}" Visibility="{Binding HasRunTimer, Converter={StaticResource Vis}}">
                        <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource Bronze}"
                                   VerticalAlignment="Center" Margin="0,1,6,0"/>
                        <TextBlock Text="{Binding RunTimerTime}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FsSection}"
                                   Foreground="{StaticResource AccentHover}" VerticalAlignment="Center" MinWidth="36" TextAlignment="Right"/>
                    </StackPanel>
                    <!-- the level is the game's own business: the stage name gets the room -->
                    <TextBlock Text="{Binding StageTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FsSection}" FontWeight="Bold"
                               Foreground="{StaticResource TitleText}" Margin="9,0,6,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" IsHitTestVisible="False" ToolTip="{Binding StageTitle}"/>
                </DockPanel>

                <!-- Act 2: which bandit the build takes -->
                <TextBlock Margin="42,-3,10,7" FontSize="{StaticResource FsSmall}" TextWrapping="Wrap" IsHitTestVisible="False"
                           Visibility="{Binding ShowMiniBandit, Converter={StaticResource Vis}}">
                    <Run Text="{l:T 'БАНДИТЫ'}" FontSize="{StaticResource FsCaption}" FontWeight="SemiBold" Foreground="{StaticResource Text3}"/><Run Text="  "/><Run Text="{Binding BanditText, Mode=OneWay}" Foreground="{StaticResource AccentHover}"/>
                </TextBlock>

                <!-- the act of the pantheon's first god: which gods the build takes -->
                <TextBlock Margin="42,-3,10,7" FontSize="{StaticResource FsSmall}" TextWrapping="Wrap" IsHitTestVisible="False"
                           Visibility="{Binding ShowMiniPantheon, Converter={StaticResource Vis}}">
                    <Run Text="{l:T 'ПАНТЕОН'}" FontSize="{StaticResource FsCaption}" FontWeight="SemiBold" Foreground="{StaticResource Text3}"/><Run Text="  "/><Run Text="{Binding PantheonText, Mode=OneWay}" Foreground="{StaticResource AccentHover}"/>
                </TextBlock>

                <!-- next labyrinth: ascendancy notables of this stage still to take -->
                <TextBlock Margin="42,-3,10,7" FontSize="{StaticResource FsSmall}" TextWrapping="Wrap" IsHitTestVisible="False"
                           Visibility="{Binding HasLabText, Converter={StaticResource Vis}}">
                    <Run Text="{l:T 'ЛАБА'}" FontSize="{StaticResource FsCaption}" FontWeight="SemiBold" Foreground="{StaticResource Text3}"/><Run Text="  "/><Run Text="{Binding LabText, Mode=OneWay}" Foreground="{StaticResource Text2}"/>
                </TextBlock>

                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource NewCharBanner}" Margin="6,0,6,6" Focusable="False"
                                Visibility="{Binding HasNewCharPrompt, Converter={StaticResource Vis}}"/>

                <!-- in town: what to buy, by vendor (each with its own search string), then what to swap in the sockets -->
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="6,8,6,6"
                        Visibility="{Binding ShowTownBlock, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding TownVendors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <!-- "Nessa  Акт 1 · 4 ——— [Поиск]" -->
                                        <Grid Margin="8,0,2,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <l:OrnamentDivider Style="{StaticResource SectionHeader}" Text="{Binding Heading}" Margin="0,0,8,0" Grid.ColumnSpan="2"/>
                                            <Button Grid.Column="2" Style="{StaticResource SmallButton}" Content="{Binding SearchButton}" Command="{Binding SearchCommand}"
                                                    ToolTip="{l:T 'Копирует строку поиска по гемам этого торговца: вставь (Ctrl+V) в поиск его окна'}"
                                                    Visibility="{Binding CanSearch, Converter={StaticResource Vis}}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Gems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Style="{StaticResource GemSocket}" IsChecked="{Binding IsBought}" ToolTip="{Binding SourceText}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" FontSize="{StaticResource FsBody}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="{StaticResource FsCaption}" Content="&#xE7BF;"
                                                                    Margin="4,0,0,0"
                                                                    Command="{Binding DataContext.TradeGemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                    ToolTip="{l:T 'Найти на трейде'}"/>
                                                        </Grid>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- new gems are the buy list above; here only what changes in existing sockets -->
                        <Border Padding="8,4,4,2" Visibility="{Binding ShowTownSwap, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,3">
                                    <l:OrnamentDivider Style="{StaticResource SectionHeader}" Text="{l:T 'Перестановка'}" Margin="0,0,96,0"/>
                                    <Button Style="{StaticResource SmallButton}" Content="{l:T '✓ Сделано'}" HorizontalAlignment="Right"
                                            Background="Transparent" BorderBrush="{StaticResource LineStrong}" Foreground="{StaticResource Text2}"
                                            Command="{Binding MarkSwapDoneCommand}" ToolTip="{l:T 'Связки уже поменял: больше не напоминать на этом этапе'}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding MiniSwapLines}" ItemTemplate="{StaticResource SwapLine}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Row="1" Visibility="{Binding Condensed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NotVis}}">
            <StackPanel x:Name="FullStage" Margin="10,10,14,0" Visibility="{Binding ShowFullStage, Converter={StaticResource Vis}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE76B;" Command="{Binding PrevCommand}" ToolTip="{Binding TipPrev}"
                            VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding StageOfText}" FontSize="{StaticResource FsCaption}" Foreground="{StaticResource Text3}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <!-- "‹ Act 4 ›": the arrows hug the name; a long name trims before the arrow is pushed away -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding StageTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FsHero}" FontWeight="Bold"
                                   Foreground="{StaticResource TitleText}" Margin="2,0,2,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding StageTitle}" MaxWidth="220"/>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE76C;" Command="{Binding NextCommand}" ToolTip="{Binding TipNext}"
                                VerticalAlignment="Center"/>
                    </Grid>
                </DockPanel>

                <ItemsControl ItemsSource="{Binding Stages}" Margin="2.5,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Pip}" ToolTip="{Binding Title}" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.SelectStageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="4,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- green: the game's log is read; a hollow ring: not linked -->
                    <Grid Width="7" Height="7" VerticalAlignment="Center">
                        <Ellipse Fill="{StaticResource Ok}" Visibility="{Binding IsGameLinked, Converter={StaticResource Vis}}"/>
                        <Ellipse Stroke="{StaticResource Text3}" StrokeThickness="1.2" Visibility="{Binding IsGameLinked, Converter={StaticResource NotVis}}"/>
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding GameLine}" Foreground="{StaticResource Text2}" FontSize="{StaticResource FsSmall}"
                               Margin="8,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <ToggleButton Grid.Column="2" Style="{StaticResource Chip}" Content="{l:T 'Авто'}" IsChecked="{Binding FollowGame}"
                                  ToolTip="{l:T 'Переключать этап по акту и уровню из игры (только вперёд)'}"/>
                </Grid>
                <!-- bandit: the plate while in its act; ✕ hides it on this stage -->
                <Border Margin="0,8,0,0" BorderBrush="{StaticResource BronzeLine}" BorderThickness="1" CornerRadius="{StaticResource RadiusM}" Padding="10,6,4,6"
                        Background="{StaticResource AccentSoft}" Visibility="{Binding ShowBanditPlate, Converter={StaticResource Vis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24" Content="&#xE8BB;" FontSize="{StaticResource FsCaption}"
                                Command="{Binding HidePlateCommand}" CommandParameter="bandit" ToolTip="{l:T 'Скрыть до следующего этапа'}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="{StaticResource FsSmall}" VerticalAlignment="Center">
                            <Run Text="{l:T 'Бандиты:'}" Foreground="{StaticResource Text3}"/><Run Text="  "/><Run Text="{Binding BanditText, Mode=OneWay}" Foreground="{StaticResource AccentHover}"/>
                        </TextBlock>
                    </DockPanel>
                </Border>
                <!-- pantheon: the plate while in its act; ✕ hides it on this stage -->
                <Border Margin="0,8,0,0" BorderBrush="{StaticResource BronzeLine}" BorderThickness="1" CornerRadius="{StaticResource RadiusM}" Padding="10,6,4,6"
                        Background="{StaticResource AccentSoft}" Visibility="{Binding ShowPantheonPlate, Converter={StaticResource Vis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24" Content="&#xE8BB;" FontSize="{StaticResource FsCaption}"
                                Command="{Binding HidePlateCommand}" CommandParameter="pantheon" ToolTip="{l:T 'Скрыть до следующего этапа'}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="{StaticResource FsSmall}" VerticalAlignment="Center">
                            <Run Text="{l:T 'Пантеон:'}" Foreground="{StaticResource Text3}"/><Run Text="  "/><Run Text="{Binding PantheonText, Mode=OneWay}" Foreground="{StaticResource AccentHover}"/>
                        </TextBlock>
                    </DockPanel>
                </Border>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource NewCharBanner}" Margin="0,10,2,0" Focusable="False"
                                Visibility="{Binding HasNewCharPrompt, Converter={StaticResource Vis}}"/>
            </StackPanel>
            </Border>

            <!-- tabs -->
            <!-- tabs: underlined, with what is waiting as a badge (gems to buy, sockets to change) -->
            <Border Grid.Row="2" Margin="14,10,14,0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                    Visibility="{Binding ShowTabs, Converter={StaticResource Vis}}">
                <UniformGrid Rows="1" Margin="0,0,0,-1">
                    <RadioButton Style="{StaticResource PanelTab}" GroupName="tab" Content="{l:T 'Гемы'}" IsChecked="{Binding IsGemsTab}" Tag="{Binding GemsBadge}"/>
                    <RadioButton Style="{StaticResource PanelTab}" GroupName="tab" Content="{l:T 'Дерево'}" IsChecked="{Binding IsTreeTab}"/>
                    <RadioButton Style="{StaticResource PanelTab}" GroupName="tab" Content="{l:T 'Связки'}" IsChecked="{Binding IsLinksTab}" Tag="{Binding LinksBadge}"/>
                    <RadioButton Style="{StaticResource PanelTab}" GroupName="tab" Content="{l:T 'Шмот'}" IsChecked="{Binding IsGearTab}"/>
                </UniformGrid>
            </Border>

            <!-- content -->
            <Grid Grid.Row="3">

                <!-- empty state -->
                <StackPanel VerticalAlignment="Center" Margin="22,0,22,30" Visibility="{Binding ShowEmpty, Converter={StaticResource Vis}}">
                    <Border Width="44" Height="44" CornerRadius="{StaticResource RadiusM}" Background="{StaticResource Surface2}" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE71B;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FsTitle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{l:T 'Импорт билда'}" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FsHero}" FontWeight="Bold" Margin="0,16,0,0"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text2}" FontSize="{StaticResource FsSmall}" Margin="0,6,0,16" LineHeight="18"
                               Text="{l:T 'Ссылка pobb.in / pastebin или сам код Path of Building. Этапы берутся из деревьев и наборов гемов PoB (Act 1, Act 2…).'}"/>
                    <TextBox Style="{StaticResource Field}" Tag="https://pobb.in/…" Text="{Binding BuildInput, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding LoadButtonText}" Command="{Binding LoadBuildCommand}" Margin="0,10,0,0"/>
                    <Button Style="{StaticResource GhostButton}" Content="{Binding SaveStageText}" Command="{Binding SaveStageCommand}" Margin="0,8,0,0"
                            ToolTip="{l:T 'Для PoB, который меняется по ходу игры (стример): каждое нажатие сохраняет то, что сейчас по ссылке, новым этапом «Ур. N».'}"/>
                    <Border Margin="0,12,0,0" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="{StaticResource RadiusM}" Padding="10,8"
                            Visibility="{Binding HasBuildError, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding BuildError}" TextWrapping="Wrap" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource Text}"/>
                    </Border>
                </StackPanel>

                <!-- gems -->
                <Grid Visibility="{Binding ShowGems, Converter={StaticResource Vis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,6,0">
                        <StackPanel Margin="14,0,8,12">
                            <Button Style="{StaticResource GhostButton}" Margin="0,0,0,10" Command="{Binding CopyVendorSearchCommand}"
                                    ToolTip="{l:T 'Копирует строку поиска по гемам, которые уже продаются и ещё не куплены: вставь (Ctrl+V) в поиск окна торговца'}"
                                    Visibility="{Binding HasTownGems, Converter={StaticResource Vis}}">
                                <TextBlock>
                                    <Run Text="{Binding VendorSearchButton, Mode=OneWay}"/><Run Text="{Binding TownCaption, Mode=OneWay, StringFormat='  ·  {0}'}" Foreground="{StaticResource Text3}" FontWeight="Normal"/>
                                </TextBlock>
                            </Button>
                            <ItemsControl ItemsSource="{Binding Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Visibility="{Binding IsVisible, Converter={StaticResource Vis}}">
                                            <!-- a PoB label without gems ("1-12"): a diamond divider between the groups of links -->
                                            <l:OrnamentDivider Text="{Binding Label}" Margin="0,4,0,10"
                                                               Visibility="{Binding IsHeader, Converter={StaticResource Vis}}"/>
                                            <!-- one link: a card, the gems' sockets joined by the bronze link bar -->
                                            <Border x:Name="card" Visibility="{Binding IsCard, Converter={StaticResource Vis}}" Background="{StaticResource Surface}"
                                                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusM}" Padding="0,3,4,3" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" Margin="10,4,8,2" TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding HasLabel, Converter={StaticResource Vis}}"/>
                                                    <ItemsControl ItemsSource="{Binding Rows}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><l:LinkedStackPanel LinkX="17" LinkY="16"/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox x:Name="cb" Style="{StaticResource GemSocket}" IsChecked="{Binding IsBought}"
                                                                          Visibility="{Binding IsVisible, Converter={StaticResource Vis}}">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="22"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                        </Grid.RowDefinitions>
                                                                        <TextBlock x:Name="name" Text="{Binding Name}" FontSize="{StaticResource FsBody}" FontWeight="SemiBold"
                                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                        <TextBlock x:Name="source" Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding SourceText}" ToolTip="{Binding SourceTip}"
                                                                                   FontSize="{StaticResource FsCaption}" Foreground="{StaticResource Text3}" Margin="0,1,0,1" TextTrimming="CharacterEllipsis"
                                                                                   Visibility="{Binding HasSource, Converter={StaticResource Vis}}"/>
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <Path Data="M5.5,1 A2.2,2.2 0 1 1 5.49,1 Z M1.5,10.5 C1.5,7.6 3.3,6.4 5.5,6.4 C7.7,6.4 9.5,7.6 9.5,10.5"
                                                                                  Width="11" Height="11" Stretch="None" Stroke="{StaticResource Text2}" StrokeThickness="1.2"
                                                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                                  Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="{l:T 'Уже стоит у персонажа'}"
                                                                                  Visibility="{Binding InCharacter, Converter={StaticResource Vis}}"/>
                                                                            <!-- NEW on this stage: a green tag -->
                                                                            <Border x:Name="newBadge" Background="{StaticResource Ok}" CornerRadius="{StaticResource RadiusS}" Padding="4,0,4,1"
                                                                                    Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsNew, Converter={StaticResource Vis}}">
                                                                                <TextBlock Text="NEW" FontSize="{StaticResource FsCaption}" FontWeight="Bold" Foreground="{StaticResource OnAccent}"/>
                                                                            </Border>
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Column="2" Text="{Binding LevelText}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FsCaption}"
                                                                                   Foreground="{StaticResource Text2}" Margin="10,0,4,0" VerticalAlignment="Center"/>
                                                                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="28" Height="22" FontSize="{StaticResource FsCaption}"
                                                                                Content="&#xE7BF;" VerticalAlignment="Center"
                                                                                Command="{Binding DataContext.TradeGemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}" ToolTip="{l:T 'Найти на трейде (дешёвые сверху)'}"/>
                                                                    </Grid>
                                                                </CheckBox>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSupport}" Value="True">
                                                                        <Setter TargetName="name" Property="FontWeight" Value="Normal"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsBought}" Value="True">
                                                                        <Setter TargetName="name" Property="Foreground" Value="{StaticResource Text3}"/>
                                                                        <Setter TargetName="name" Property="TextDecorations" Value="Strikethrough"/>
                                                                        <Setter TargetName="newBadge" Property="Opacity" Value="0.35"/>
                                                                        <Setter TargetName="source" Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <!-- the second weapon set: gems levelled for later, not the build: dashed and dim, the why on hover -->
                                            <DataTrigger Binding="{Binding IsSwap}" Value="True">
                                                <Setter TargetName="card" Property="Opacity" Value="0.8"/>
                                                <Setter TargetName="card" Property="ToolTip" Value="{x:Static l:GroupVm.SwapText}"/>
                                                <Setter TargetName="card" Property="BorderBrush">
                                                    <Setter.Value>
                                                        <VisualBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute" Viewbox="0,0,8,8" ViewboxUnits="Absolute">
                                                            <VisualBrush.Visual>
                                                                <Grid Width="8" Height="8">
                                                                    <Rectangle Width="4" Height="8" HorizontalAlignment="Left" Fill="{StaticResource Gold}"/>
                                                                </Grid>
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel HorizontalAlignment="Center" Margin="0,30,0,0" Visibility="{Binding ShowAllBought, Converter={StaticResource Vis}}">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FsTitle}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{l:T 'На этом этапе всё куплено'}" Foreground="{StaticResource Text2}" Margin="0,8,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{l:T 'В PoB нет гемов для этого этапа'}" Foreground="{StaticResource Text2}" HorizontalAlignment="Center" Margin="0,30,0,0"
                                       Visibility="{Binding HasNoGems, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- links: one-off choices, what to swap on this stage, then every link of the build as a card -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,6,0"
                              Visibility="{Binding ShowLinks, Converter={StaticResource Vis}}">
                    <StackPanel Margin="14,0,8,14">

                        <!-- what changes in the sockets when this stage starts; "✓ Сделано" folds it and stops the reminders in town -->
                        <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource BronzeLine}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusM}" Padding="10,7,10,8" Margin="0,0,0,8"
                                Visibility="{Binding HasSwap, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:T 'Переставить на этом этапе'}" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FsSection}"
                                               Foreground="{StaticResource AccentHover}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SwapCaption}"/>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource SmallButton}" IsChecked="{Binding IsSwapDone}" Margin="8,0,0,0"
                                                  Background="Transparent" BorderBrush="{StaticResource LineStrong}" Foreground="{StaticResource Text2}"
                                                  Content="{l:T '✓ Сделано'}" ToolTip="{l:T 'Связки уже поменял: свернуть и не напоминать в городе'}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding SwapLines}" ItemTemplate="{StaticResource SwapLine}" Margin="0,4,0,0"
                                              Visibility="{Binding ShowSwapLines, Converter={StaticResource Vis}}"/>
                            </StackPanel>
                        </Border>

                        <l:OrnamentDivider Text="{l:T 'Связки билда'}" Margin="0,2,0,8" Visibility="{Binding HasLinkGroups, Converter={StaticResource Vis}}"/>

                        <ItemsControl ItemsSource="{Binding LinkGroups}" Visibility="{Binding HasLinkGroups, Converter={StaticResource Vis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="card" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusM}" Padding="10,7,10,7" Margin="0,0,0,8">
                                        <StackPanel>
                                            <!-- the item the link sits in, as PoB says, and the sockets it needs -->
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="slot" Text="{Binding SlotCaption}" Style="{StaticResource Caption}" FontSize="{StaticResource FsCaption}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="swapCap" Text="{l:T 'ВТОРОЙ СЕТ ОРУЖИЯ · ПРОКАЧКА'}" Style="{StaticResource Caption}" FontSize="{StaticResource FsCaption}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Visibility="{Binding IsSwap, Converter={StaticResource Vis}}"/>
                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Sockets}" VerticalAlignment="Center" IsHitTestVisible="False">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="6" Height="3" Background="{StaticResource Bronze}" VerticalAlignment="Center"
                                                                        Visibility="{Binding Linked, Converter={StaticResource Vis}}"/>
                                                                <Ellipse Width="11" Height="11" Fill="{Binding Brush}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Grid.Column="2" Text="{Binding LinkText}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FsCaption}"
                                                           Foreground="{StaticResource BronzeText}" MinWidth="22" TextAlignment="Right" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Gems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- a click copies the gem's name (stash or vendor search) -->
                                                        <Grid x:Name="line" Background="Transparent" Cursor="Hand" Margin="0,1,0,1" ToolTip="{l:T 'Клик — скопировать имя гема'}">
                                                            <Grid.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick"
                                                                              Command="{Binding DataContext.CopyGemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                              CommandParameter="{Binding}"/>
                                                            </Grid.InputBindings>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Ellipse x:Name="dot" Width="8" Height="8" Fill="{Binding Brush}" Margin="16,0,8,0" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="name" Grid.Column="1" Foreground="{StaticResource Text2}" FontSize="{StaticResource FsSmall}"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding NameTip}" VerticalAlignment="Center">
                                                                <Run Text="{Binding Name, Mode=OneWay}"/><Run x:Name="from" Text="{Binding FromText, Mode=OneWay}"
                                                                     Foreground="{StaticResource Text3}" FontStyle="Normal"/><Run Text="{Binding OffText, Mode=OneWay}"
                                                                     Foreground="{StaticResource Text3}" FontStyle="Normal"/>
                                                            </TextBlock>
                                                            <TextBlock x:Name="level" Grid.Column="2" Text="{Binding Level}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FsCaption}"
                                                                       Foreground="{StaticResource Text2}" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="{Binding LevelTip}"/>
                                                        </Grid>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding KeepLevel}" Value="True">
                                                                <Setter TargetName="level" Property="Foreground" Value="{StaticResource Text}"/>
                                                                <Setter TargetName="level" Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                            <!-- the main gem: no indent, 13 semibold -->
                                                            <DataTrigger Binding="{Binding IsHead}" Value="True">
                                                                <Setter TargetName="dot" Property="Margin" Value="0,0,8,0"/>
                                                                <Setter TargetName="name" Property="FontWeight" Value="SemiBold"/>
                                                                <Setter TargetName="name" Property="FontSize" Value="{StaticResource FsBody}"/>
                                                                <Setter TargetName="name" Property="Foreground" Value="{StaticResource Text}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsOff}" Value="True">
                                                                <Setter TargetName="name" Property="Opacity" Value="0.5"/>
                                                                <Setter TargetName="level" Property="Opacity" Value="0.5"/>
                                                                <Setter TargetName="dot" Property="Opacity" Value="0.5"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsGranted}" Value="True">
                                                                <Setter TargetName="name" Property="FontStyle" Value="Italic"/>
                                                                <Setter TargetName="line" Property="Cursor" Value="Arrow"/>
                                                                <Setter TargetName="line" Property="ToolTip" Value="{x:Null}"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding Note}" FontSize="{StaticResource FsCaption}" Foreground="{StaticResource Text3}" TextWrapping="Wrap" Margin="16,3,0,0"
                                                       Visibility="{Binding HasNote, Converter={StaticResource Vis}}"/>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <!-- the second weapon set: levelled for later, not the build — dashed and dim -->
                                        <DataTrigger Binding="{Binding IsSwap}" Value="True">
                                            <Setter TargetName="card" Property="Opacity" Value="0.8"/>
                                            <Setter TargetName="card" Property="BorderBrush">
                                                <Setter.Value>
                                                    <VisualBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute" Viewbox="0,0,8,8" ViewboxUnits="Absolute">
                                                        <VisualBrush.Visual>
                                                            <Grid Width="8" Height="8">
                                                                <Rectangle Width="4" Height="8" HorizontalAlignment="Left" Fill="{StaticResource LineStrong}"/>
                                                            </Grid>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="slot" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{l:T 'В PoB нет гемов для этого этапа'}" Foreground="{StaticResource Text2}" HorizontalAlignment="Center" Margin="0,30,0,0"
                                   Visibility="{Binding HasNoGems, Converter={StaticResource Vis}}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- gear: the stage's PoB item set as short rows (icon, name, slot); a row opens into the full card -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,6,0"
                              Visibility="{Binding ShowGear, Converter={StaticResource Vis}}">
                    <ScrollViewer.Resources>
                        <DataTemplate x:Key="GearRow">
                            <Grid Margin="0,0,0,4">
                            <Border x:Name="card" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" CornerRadius="{StaticResource RadiusM}"
                                    BorderThickness="1" SnapsToDevicePixels="True">
                                <StackPanel>
                                    <!-- the row: art | name in the rarity colour, slot | chevron; a click opens or folds the card -->
                                    <Border x:Name="head" Background="Transparent" Padding="5,5,6,5" Cursor="Hand" CornerRadius="{StaticResource RadiusM}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleCommand}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="{StaticResource RadiusS}" Background="{StaticResource Well}"
                                                    BorderBrush="{StaticResource Line}" BorderThickness="1" VerticalAlignment="Center">
                                                <Image Source="{Binding Icon}" Margin="2" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" Foreground="{Binding RarityBrush}" FontFamily="{StaticResource DisplayFont}"
                                                           FontSize="{StaticResource FsSection}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SlotText}" FontSize="{StaticResource FsCaption}" Foreground="{StaticResource Text3}"/>
                                            </StackPanel>
                                            <TextBlock x:Name="chevron" Grid.Column="2" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FsCaption}"
                                                       Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="2,0,4,0"/>
                                        </Grid>
                                    </Border>

                                    <!-- the full card: everything about the item, left-aligned -->
                                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}" Margin="10,0,10,10">
                                        <Border Height="1" Background="{StaticResource OrnamentFadeOut}" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding BaseType}" Foreground="{StaticResource Text2}" FontSize="{StaticResource FsSmall}" TextWrapping="Wrap"
                                                   Visibility="{Binding ShowBase, Converter={StaticResource Vis}}"/>
                                        <!-- the item's influences, each in the colour its mods are painted below -->
                                        <ItemsControl ItemsSource="{Binding Influences}" Margin="0,2,0,0"
                                                      Visibility="{Binding HasInfluences, Converter={StaticResource Vis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontSize="{StaticResource FsCaption}">
                                                        <Run Text="{Binding Sep, Mode=OneWay}" Foreground="{StaticResource Text3}"/><Run Text="{Binding Name, Mode=OneWay}" Foreground="{Binding Brush}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding SocketsText}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FsCaption}"
                                                   Foreground="{StaticResource Text3}" Margin="0,4,0,0"
                                                   Visibility="{Binding HasSockets, Converter={StaticResource Vis}}"/>
                                        <ItemsControl ItemsSource="{Binding Implicits}" Margin="0,6,0,0"
                                                      Visibility="{Binding HasImplicits, Converter={StaticResource Vis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- an anointment: its three oils beside it, the name on hover -->
                                                    <WrapPanel>
                                                        <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontSize="{StaticResource FsSmall}" TextWrapping="Wrap"
                                                                   VerticalAlignment="Center"/>
                                                        <ItemsControl ItemsSource="{Binding Oils}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                      Visibility="{Binding HasOils, Converter={StaticResource Vis}}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="Transparent" Padding="1,0" ToolTip="{Binding Name}" Cursor="Help"
                                                                            Width="22" Height="22">
                                                                        <Grid>
                                                                            <!-- the game's oil icon; a drop in the oil's colour until it is downloaded -->
                                                                            <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                                                                   Visibility="{Binding HasIcon, Converter={StaticResource Vis}}"/>
                                                                            <Path Data="M5,0 C5,0 10,6.5 10,9.5 A5,5 0 0 1 0,9.5 C0,6.5 5,0 5,0 Z" Width="10" Height="15"
                                                                                  Fill="{Binding Fill}" Stroke="{Binding Edge}" StrokeThickness="1" Stretch="None"
                                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                  Visibility="{Binding HasIcon, Converter={StaticResource NotVis}}"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </WrapPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Height="1" Margin="0,7,40,1" Background="{StaticResource Line}" HorizontalAlignment="Stretch"
                                                Visibility="{Binding HasImplicits, Converter={StaticResource Vis}}"/>
                                        <ItemsControl ItemsSource="{Binding Explicits}" Margin="0,6,0,0"
                                                      Visibility="{Binding HasExplicits, Converter={StaticResource Vis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontSize="{StaticResource FsSmall}" TextWrapping="Wrap" Margin="0,0,0,1"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Corrupted" Foreground="{Binding CorruptBrush}" FontSize="{StaticResource FsSmall}" Margin="0,6,0,0"
                                                   Visibility="{Binding Corrupted, Converter={StaticResource Vis}}"/>
                                        <!-- a cluster jewel: how many of its small passives the stage takes ("малые 2/3"), then the passives themselves -->
                                        <TextBlock Text="{Binding ClusterSummary}" Foreground="{Binding ClusterSummaryBrush}" FontSize="{StaticResource FsSmall}" Margin="0,8,0,0"
                                                   TextWrapping="Wrap" Visibility="{Binding HasClusterSummary, Converter={StaticResource Vis}}"/>
                                        <ItemsControl ItemsSource="{Binding TreeLines}" Margin="0,8,0,0"
                                                      Visibility="{Binding HasTreeLines, Converter={StaticResource Vis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontSize="{StaticResource FsSmall}" TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- two separate actions, like the trade sites do: search, or the item text for PoB / chat -->
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Style="{StaticResource PrimaryButton}" Content="{Binding TradeButton}" Command="{Binding TradeCommand}" Padding="10,7"
                                                    FontSize="{StaticResource FsSmall}"
                                                    ToolTip="{l:T 'Окно прайс-чека на этот предмет: выбери фильтры, потом «Искать» или «Открыть на трейде»'}"/>
                                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="{Binding CopyButton}" Command="{Binding CopyCommand}" Padding="10,7"
                                                    FontSize="{StaticResource FsSmall}"
                                                    ToolTip="{l:T 'Текст предмета в буфер: вставить в PoB (Create custom) или в чат'}"/>
                                        </Grid>
                                        <!-- a timeless jewel: what it does around its socket, on Vilsol's calculator -->
                                        <Button Style="{StaticResource GhostButton}" Content="{l:T 'Что даёт в этом сокете ↗'}" Command="{Binding TimelessCommand}"
                                                Margin="0,6,0,0" ToolTip="{Binding TimelessTip}" FontSize="{StaticResource FsSmall}"
                                                Visibility="{Binding HasTimeless, Converter={StaticResource Vis}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- the mark of a hovered / opened card: a straight bar on a square left edge (a bar on a round corner looks crumpled) -->
                            <Rectangle x:Name="bar" Width="2" HorizontalAlignment="Left" Fill="{StaticResource Accent}" Visibility="Hidden" IsHitTestVisible="False"
                                       SnapsToDevicePixels="True"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="head" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource HoverBorder}"/>
                                    <Setter TargetName="card" Property="CornerRadius" Value="0,6,6,0"/>
                                    <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                    <Setter TargetName="chevron" Property="Text" Value="&#xE70E;"/>
                                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource BronzeLine}"/>
                                    <Setter TargetName="card" Property="CornerRadius" Value="0,6,6,0"/>
                                    <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ScrollViewer.Resources>
                    <StackPanel Margin="14,0,8,14">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="{Binding GearCaption}" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FsBody}" Foreground="{StaticResource BronzeText}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,100,0"/>
                            <Button Style="{StaticResource GhostButton}" Content="{Binding ExpandAllText}" Command="{Binding ExpandAllCommand}" HorizontalAlignment="Right"
                                    Padding="10,4" FontSize="{StaticResource FsCaption}" Background="Transparent" Visibility="{Binding HasGear, Converter={StaticResource Vis}}"/>
                        </Grid>
                        <!-- no set named for this stage: a quiet note, not a boxed warning -->
                        <Grid Margin="0,0,0,8" Visibility="{Binding HasGearNote, Converter={StaticResource Vis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource Bronze}"
                                       VerticalAlignment="Top" Margin="0,2,8,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding GearNote}" TextWrapping="Wrap" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource Text2}"/>
                        </Grid>
                        <!-- by groups: weapons (the second set apart), armour, jewellery, flasks, special slots, jewels in the tree;
                             a click on a heading folds its group (remembered per build) -->
                        <ItemsControl ItemsSource="{Binding GearGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,4">
                                        <Border Background="Transparent" Cursor="Hand" Padding="0,6,0,6" ToolTip="{l:T 'Свернуть или развернуть группу'}">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleCommand}"/>
                                            </Border.InputBindings>
                                            <l:OrnamentDivider Text="{Binding Title}"/>
                                        </Border>
                                        <StackPanel Visibility="{Binding IsOpen, Converter={StaticResource Vis}}">
                                            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource GearRow}"/>
                                            <StackPanel Opacity="0.8" Visibility="{Binding HasSwap, Converter={StaticResource Vis}}">
                                                <TextBlock Text="{l:T 'Свап'}" Style="{StaticResource Caption}" Margin="4,4,0,4"
                                                           ToolTip="{x:Static l:GroupVm.SwapText}"/>
                                                <ItemsControl ItemsSource="{Binding Swap}" ItemTemplate="{StaticResource GearRow}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{l:T 'В PoB нет шмота для этого этапа'}" Foreground="{StaticResource Text2}" HorizontalAlignment="Center" Margin="0,30,0,0"
                                   Visibility="{Binding HasNoGear, Converter={StaticResource Vis}}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- tree summary -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,6,0"
                              Visibility="{Binding ShowTreeTab, Converter={StaticResource Vis}}">
                    <StackPanel Margin="14,0,8,14">
                        <Border Background="{StaticResource Surface}" CornerRadius="{StaticResource RadiusM}" Padding="12,9" Margin="0,0,0,10"
                                Visibility="{Binding HasTreeHint, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding TreeHint}" Foreground="{StaticResource Text2}" TextWrapping="Wrap" FontSize="{StaticResource FsSmall}"/>
                        </Border>

                        <UniformGrid Columns="3" Margin="0,0,-6,0">
                            <Border Background="{StaticResource Surface}" CornerRadius="{StaticResource RadiusM}" Padding="12,10" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding PointsToTake}" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FsHero}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{l:T 'ВЗЯТЬ'}" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Surface}" CornerRadius="{StaticResource RadiusM}" Padding="12,10" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding RefundCount}" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FsHero}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{l:T 'СНЯТЬ'}" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Surface}" CornerRadius="{StaticResource RadiusM}" Padding="12,10" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding AscendancyCount}" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FsHero}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{l:T 'АСЦЕНД'}" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Background="{StaticResource Surface}" CornerRadius="{StaticResource RadiusM}" Padding="3" Margin="0,12,0,0">
                            <UniformGrid Rows="1">
                                <RadioButton Style="{StaticResource Segment}" GroupName="cmp" Content="{l:T 'От прошлого этапа'}" IsChecked="{Binding CompareWithPrevious}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="cmp" Content="{l:T 'От персонажа'}" IsChecked="{Binding CompareWithCharacter}"/>
                            </UniformGrid>
                        </Border>
                        <TextBlock Text="{Binding CompareHint}" Foreground="{StaticResource Text3}" FontSize="{StaticResource FsSmall}" Margin="4,6,0,0" TextWrapping="Wrap"/>

                        <Button Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" Click="OpenTree_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{l:T 'Открыть дерево'}"/>
                                <TextBlock Text="{Binding KeyTree}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FsCaption}" Opacity="0.55" Margin="10,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Visibility="{Binding HasAscendancy, Converter={StaticResource Vis}}" Margin="0,18,0,0">
                            <l:OrnamentDivider Text="{l:T 'Асцендант'}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding AscendancyNodes}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="{StaticResource RadiusM}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" Padding="10,4" Margin="0,0,6,6">
                                            <TextBlock Text="{Binding}" FontSize="{StaticResource FsSmall}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>


                        <!-- the stage's choices on the tree, as poe.ninja shows a character: masteries by kind, runegrafts, tattoos -->
                        <StackPanel Visibility="{Binding HasMasteryPicks, Converter={StaticResource Vis}}" Margin="0,16,0,0">
                            <l:OrnamentDivider Text="{l:T 'Мастери'}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding MasteryPicks}" ItemTemplate="{StaticResource TreePick}"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding HasRunegraftPicks, Converter={StaticResource Vis}}" Margin="0,10,0,0">
                            <l:OrnamentDivider Text="{l:T 'Руны'}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding RunegraftPicks}" ItemTemplate="{StaticResource TreePick}"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding HasTattooPicks, Converter={StaticResource Vis}}" Margin="0,10,0,0">
                            <l:OrnamentDivider Text="{l:T 'Татуировки'}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding TattooPicks}" ItemTemplate="{StaticResource TreePick}"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasKeyNodes, Converter={StaticResource Vis}}" Margin="0,16,0,0">
                            <l:OrnamentDivider Text="{l:T 'Порядок ключевых узлов'}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding KeyNodes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Step}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FsCaption}" Foreground="{StaticResource Text3}" Margin="0,2,0,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontSize="{StaticResource FsBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource Text3}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- footer -->
            <!-- shown on every full page: the close-app button lives here; "Куплено N из M" and its bar only on the gems tab -->
            <Border x:Name="Footer" Grid.Row="4" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="{StaticResource Well}" CornerRadius="0,0,9,9"
                    Padding="14,10,22,10" Margin="0,6,0,0" Visibility="{Binding IsCompact, Converter={StaticResource NotVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0" Visibility="{Binding ShowGems, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource Text2}" FontSize="{StaticResource FsSmall}"/>
                        <Border Height="4" CornerRadius="2" Background="{StaticResource Line}" ClipToBounds="True" Margin="0,5,0,0">
                            <Border Background="{StaticResource Accent}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding Progress}"/>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- was a settings button: an action of the gems tab, so it lives by the gems -->
                        <Button Style="{StaticResource IconButton}" Content="&#xE762;" FontSize="{StaticResource FsBody}" Margin="0,0,4,0" Command="{Binding MarkAllCommand}"
                                ToolTip="{l:T 'Отметить / снять все гемы этапа'}" Visibility="{Binding ShowGems, Converter={StaticResource Vis}}"/>
                        <ToggleButton Style="{StaticResource Chip}" Content="{l:T 'Скрыть купленные'}" IsChecked="{Binding HideBought}" FontSize="{StaticResource FsSmall}"
                                      Padding="10,6" Visibility="{Binding ShowGems, Converter={StaticResource Vis}}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE7E8;" FontSize="{StaticResource FsSmall}" Margin="4,0,0,0"
                                ToolTip="{l:T 'Закрыть приложение'}" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- toast: on the full panel over the footer's line (progress and buttons, for the toast's two seconds) — above it,
                 it covered the list (gems, links); in the mini tracker a strip under its line (the footer row is empty there),
                 so it neither hides the stage nor blows the one-line window up with a margin. It takes the clicks, so a click
                 meant for it never lands on the hidden close-app button. -->
            <Border Grid.Row="4" Background="{StaticResource Accent}"
                    Visibility="{Binding IsToastVisible, Converter={StaticResource Vis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="VerticalAlignment" Value="Bottom"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="12,0,12,11"/>
                        <Setter Property="MinHeight" Value="34"/>
                        <Setter Property="CornerRadius" Value="{StaticResource RadiusM}"/>
                        <Setter Property="Padding" Value="14,8"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="Margin" Value="6,0,6,6"/>
                                <Setter Property="CornerRadius" Value="{StaticResource RadiusM}"/>
                                <Setter Property="Padding" Value="10,6"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ToastText}" Foreground="{StaticResource OnAccent}" FontSize="{StaticResource FsSmall}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </ContentControl>
</Window>
