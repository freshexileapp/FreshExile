<Window x:Class="FreshExile.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FreshExile.App"
        Title="Fresh Exile" Width="380" Height="740" MinWidth="320" MinHeight="180" Icon="app.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ResizeMode="CanResizeWithGrip"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- the log shows another character: offer a fresh start from stage 1 -->
        <DataTemplate x:Key="NewCharBanner">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="7" Padding="10,8"
                    Visibility="{Binding HasNewCharPrompt, Converter={StaticResource Vis}}">
                <StackPanel>
                    <TextBlock Text="{Binding NewCharText}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{l:T 'Отметки «куплено» этого билда сбросятся.'}" FontSize="11" Foreground="{StaticResource Text3}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    <UniformGrid Rows="1" Margin="0,8,-6,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="{l:T 'С этапа 1'}" Padding="10,5" Command="{Binding AcceptNewCharCommand}" Margin="0,0,6,0"/>
                        <Button Style="{StaticResource GhostButton}" Content="{l:T 'Нет, тот же'}" Padding="10,5" Command="{Binding DismissNewCharCommand}" Margin="0,0,6,0"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- outline as two filled layers: a stroked rounded border looks thinner on the arcs than on the straight edges -->
    <Border Background="{StaticResource Line}" CornerRadius="10" Padding="1" UseLayoutRounding="False">
    <Border Background="{StaticResource PanelBrush}" CornerRadius="9">
        <Grid UseLayoutRounding="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Grid.Row="0" Margin="14,12,10,0" Background="Transparent" MouseLeftButtonDown="Drag_MouseDown"
                  Visibility="{Binding ShowMini, Converter={StaticResource NotVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Image Source="logo.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="FRESH EXILE" Style="{StaticResource Caption}" FontSize="9.5"/>
                        <TextBlock Text="{Binding BuildLine}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="{l:T 'Настройки'}" Click="Settings_Click"/>
                    <!-- X folds into the mini tracker; the app itself closes from the footer -->
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10" ToolTip="{l:T 'Свернуть в мини'}" Click="Collapse_Click"/>
                </StackPanel>
            </Grid>

            <!-- stage -->
            <!-- mini tracker: one line in the field, gem shopping only in town -->
            <StackPanel Grid.Row="1" Visibility="{Binding ShowMini, Converter={StaticResource Vis}}">
                <!-- icon | stage + level (the stage name trims, never the timer) | timer | buttons -->
                <!-- DockPanel, not a Grid: a Grid's Auto column under SizeToContent did not widen when the clock
                     went 0:9 -> 0:10, and the chip text got cut on both sides -->
                <DockPanel Margin="10,7,6,7" Background="Transparent" MouseLeftButtonDown="Drag_MouseDown" LastChildFill="True">
                    <Image DockPanel.Dock="Left" Source="logo.png" Width="22" Height="22" VerticalAlignment="Center" IsHitTestVisible="False"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="10" Content="&#xE76B;" Command="{Binding PrevCommand}" ToolTip="{Binding TipPrev}"/>
                        <Button Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="10" Content="&#xE76C;" Command="{Binding NextCommand}" ToolTip="{Binding TipNext}"/>
                        <Button Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="10" Content="&#xE70E;" ToolTip="{l:T 'Развернуть'}" Click="Compact_Click"/>
                    </StackPanel>
                    <!-- run clock as a quiet chip: "карта  0:12"; the time keeps a minimum width so the chip does not twitch every second -->
                    <Border DockPanel.Dock="Right" Background="{StaticResource Surface}" CornerRadius="6" Padding="7,2,7,3" Margin="2,0,6,0"
                            VerticalAlignment="Center" ToolTip="{Binding RunTimerTip}"
                            Visibility="{Binding HasRunTimer, Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding RunTimerLabel}" FontSize="10.5" Foreground="{StaticResource Text3}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding RunTimerTime}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text}" VerticalAlignment="Center" MinWidth="30" TextAlignment="Right"/>
                        </StackPanel>
                    </Border>
                    <!-- the level is the game's own business: the stage name gets the room -->
                    <TextBlock Text="{Binding StageTitle}" FontSize="14" FontWeight="SemiBold" Margin="9,0,6,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" IsHitTestVisible="False" ToolTip="{Binding StageTitle}"/>
                </DockPanel>

                <!-- Act 2: which bandit the build takes -->
                <TextBlock Margin="39,-3,10,7" FontSize="11.5" TextWrapping="Wrap" IsHitTestVisible="False"
                           Visibility="{Binding ShowMiniBandit, Converter={StaticResource Vis}}">
                    <Run Text="{l:T 'БАНДИТЫ'}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource Text3}"/><Run Text="  "/><Run Text="{Binding BanditText, Mode=OneWay}" Foreground="{StaticResource Text2}"/>
                </TextBlock>

                <!-- next labyrinth: ascendancy notables of this stage still to take -->
                <TextBlock Margin="39,-3,10,7" FontSize="11.5" TextWrapping="Wrap" IsHitTestVisible="False"
                           Visibility="{Binding HasLabText, Converter={StaticResource Vis}}">
                    <Run Text="{l:T 'ЛАБА'}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource Text3}"/><Run Text="  "/><Run Text="{Binding LabText, Mode=OneWay}" Foreground="{StaticResource Text2}"/>
                </TextBlock>

                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource NewCharBanner}" Margin="6,0,6,6" Focusable="False"
                                Visibility="{Binding HasNewCharPrompt, Converter={StaticResource Vis}}"/>

                <Border Margin="6,0,6,6" Background="{StaticResource Surface}"
                        CornerRadius="7" Padding="3,7,3,4" Visibility="{Binding ShowTownBlock, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding TownCaption}" Style="{StaticResource Caption}" FontSize="9.5" Margin="9,0,0,3"/>
                        <ItemsControl ItemsSource="{Binding TownGems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource GemOrb}" IsChecked="{Binding IsBought}" ToolTip="{Binding SourceText}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding NpcWithAct}" FontSize="11" Foreground="{StaticResource Text3}" Margin="10,0,2,0" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="20" Height="20" FontSize="10" Content="&#xE7BF;" Margin="2,0,0,0"
                                                    Command="{Binding DataContext.TradeGemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    ToolTip="{l:T 'Найти на трейде'}"/>
                                        </Grid>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource GhostButton}" Content="{Binding VendorSearchButton}" FontSize="11.5" Padding="8,4" Margin="6,4,6,2"
                                HorizontalAlignment="Left" Command="{Binding CopyVendorSearchCommand}"
                                ToolTip="{l:T 'Копирует строку поиска по этим гемам: вставь (Ctrl+V) в поиск окна торговца'}"
                                Visibility="{Binding HasTownGems, Converter={StaticResource Vis}}"/>
                        <!-- new gems are the buy list above; here only what changes in existing sockets -->
                        <StackPanel Margin="9,5,6,2" Visibility="{Binding ShowTownSwap, Converter={StaticResource Vis}}">
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="{l:T 'ЗАМЕНА'}" Style="{StaticResource Caption}" FontSize="9.5" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource GhostButton}" Content="{l:T '✓ сделано'}" FontSize="10.5" Padding="6,1" HorizontalAlignment="Right"
                                        Command="{Binding MarkSwapDoneCommand}" ToolTip="{l:T 'Связки уже поменял: больше не напоминать на этом этапе'}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding MiniSwapLines}" ItemTemplate="{StaticResource SwapLine}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="18,16,14,0" Visibility="{Binding ShowFullStage, Converter={StaticResource Vis}}">
                <Grid>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding StageNumberText}"/>
                        <TextBlock Text="{Binding StageTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="28"
                                   FontWeight="SemiBold" Margin="0,1,72,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding StageSubtitle}" Foreground="{StaticResource Text2}" FontSize="12" Margin="0,1,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,0,0">
                        <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Command="{Binding PrevCommand}" ToolTip="{Binding TipPrev}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Command="{Binding NextCommand}" ToolTip="{Binding TipNext}"/>
                    </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding Stages}" Margin="-1.5,10,2,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Pip}" ToolTip="{Binding Title}" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.SelectStageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,8,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="7" Height="7" VerticalAlignment="Center">
                        <Ellipse Fill="{StaticResource Accent}" Visibility="{Binding IsGameLinked, Converter={StaticResource Vis}}"/>
                        <Ellipse Stroke="{StaticResource Text3}" StrokeThickness="1.2" Visibility="{Binding IsGameLinked, Converter={StaticResource NotVis}}"/>
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding GameLine}" Foreground="{StaticResource Text2}" FontSize="11.5"
                               Margin="8,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <ToggleButton Grid.Column="2" Style="{StaticResource Chip}" Content="{l:T 'Авто'}" IsChecked="{Binding FollowGame}"
                                  ToolTip="{l:T 'Переключать этап по акту и уровню из игры (только вперёд)'}"/>
                </Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource NewCharBanner}" Margin="0,10,2,0" Focusable="False"
                                Visibility="{Binding HasNewCharPrompt, Converter={StaticResource Vis}}"/>
            </StackPanel>

            <!-- tabs -->
            <Border Grid.Row="2" Margin="14,14,14,0" Background="{StaticResource Surface}" CornerRadius="10" Padding="3"
                    Visibility="{Binding ShowTabs, Converter={StaticResource Vis}}">
                <UniformGrid Rows="1">
                    <RadioButton Style="{StaticResource Segment}" GroupName="tab" Content="{l:T 'Гемы'}" IsChecked="{Binding IsGemsTab}"/>
                    <RadioButton Style="{StaticResource Segment}" GroupName="tab" Content="{l:T 'Дерево'}" IsChecked="{Binding IsTreeTab}"/>
                    <RadioButton Style="{StaticResource Segment}" GroupName="tab" Content="{l:T 'Связки'}" IsChecked="{Binding IsLinksTab}"/>
                    <RadioButton Style="{StaticResource Segment}" GroupName="tab" Content="{l:T 'Гир'}" IsChecked="{Binding IsGearTab}"/>
                </UniformGrid>
            </Border>

            <!-- content -->
            <Grid Grid.Row="3">

                <!-- empty state -->
                <StackPanel VerticalAlignment="Center" Margin="22,0,22,30" Visibility="{Binding ShowEmpty, Converter={StaticResource Vis}}">
                    <Border Width="44" Height="44" CornerRadius="8" Background="{StaticResource Surface2}" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE71B;" FontFamily="{StaticResource IconFont}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{l:T 'Импорт билда'}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" Margin="0,16,0,0"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text2}" FontSize="12.5" Margin="0,6,0,16" LineHeight="18"
                               Text="{l:T 'Ссылка pobb.in / pastebin или сам код Path of Building. Этапы берутся из деревьев и наборов гемов PoB (Act 1, Act 2…).'}"/>
                    <TextBox Style="{StaticResource Field}" Tag="https://pobb.in/…" Text="{Binding BuildInput, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding LoadButtonText}" Command="{Binding LoadBuildCommand}" Margin="0,10,0,0"/>
                    <Button Style="{StaticResource GhostButton}" Content="{Binding SaveStageText}" Command="{Binding SaveStageCommand}" Margin="0,8,0,0"
                            ToolTip="{l:T 'Для PoB, который меняется по ходу игры (стример): каждое нажатие сохраняет то, что сейчас по ссылке, новым этапом «Ур. N».'}"/>
                    <Border Margin="0,12,0,0" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="9" Padding="10,8"
                            Visibility="{Binding HasBuildError, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding BuildError}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Text}"/>
                    </Border>
                </StackPanel>

                <!-- gems -->
                <Grid Visibility="{Binding ShowGems, Converter={StaticResource Vis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,4,0">
                        <StackPanel Margin="14,0,8,12">
                            <Button Style="{StaticResource GhostButton}" Margin="0,0,0,10" Command="{Binding CopyVendorSearchCommand}"
                                    ToolTip="{l:T 'Копирует строку поиска по гемам, которые уже продаются и ещё не куплены: вставь (Ctrl+V) в поиск окна торговца'}"
                                    Visibility="{Binding HasTownGems, Converter={StaticResource Vis}}">
                                <TextBlock>
                                    <Run Text="{Binding VendorSearchButton, Mode=OneWay}"/><Run Text="{Binding TownCaption, Mode=OneWay, StringFormat='  ·  {0}'}" Foreground="{StaticResource Text3}" FontWeight="Normal"/>
                                </TextBlock>
                            </Button>
                            <!-- what changes in the sockets when this stage starts -->
                            <Border Background="{StaticResource Surface}"
                                    CornerRadius="8" Padding="12,9,12,10" Margin="0,0,0,10"
                                    Visibility="{Binding HasSwap, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding SwapCaption}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource Chip}" Content="{l:T 'Сделано'}" IsChecked="{Binding IsSwapDone}" Margin="8,0,0,0"
                                                      ToolTip="{l:T 'Связки уже поменял: свернуть и не напоминать в городе'}"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding SwapLines}" ItemTemplate="{StaticResource SwapLine}" Margin="0,6,0,0"
                                                  Visibility="{Binding ShowSwapLines, Converter={StaticResource Vis}}"/>
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Visibility="{Binding IsVisible, Converter={StaticResource Vis}}">
                                            <Grid Margin="4,8,4,8" Visibility="{Binding IsHeader, Converter={StaticResource Vis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" FontSize="11" Foreground="{StaticResource Text2}"/>
                                                <Border Grid.Column="1" Height="1" Background="{StaticResource Line}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Border Visibility="{Binding IsCard, Converter={StaticResource Vis}}" Background="{StaticResource Surface}"
                                                    CornerRadius="8" Padding="4" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" Margin="10,5,8,2" TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding HasLabel, Converter={StaticResource Vis}}"/>
                                                    <ItemsControl ItemsSource="{Binding Rows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox x:Name="cb" Style="{StaticResource GemOrb}" IsChecked="{Binding IsBought}"
                                                                          Visibility="{Binding IsVisible, Converter={StaticResource Vis}}">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="18"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                        </Grid.RowDefinitions>
                                                                        <TextBlock x:Name="name" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                        <TextBlock x:Name="source" Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding SourceText}" ToolTip="{Binding SourceTip}"
                                                                                   FontSize="11" Foreground="{StaticResource Text3}" Margin="0,1,0,1" TextTrimming="CharacterEllipsis"
                                                                                   Visibility="{Binding HasSource, Converter={StaticResource Vis}}"/>
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <Path Data="M5.5,1 A2.2,2.2 0 1 1 5.49,1 Z M1.5,10.5 C1.5,7.6 3.3,6.4 5.5,6.4 C7.7,6.4 9.5,7.6 9.5,10.5"
                                                                                  Width="11" Height="11" Stretch="None" Stroke="{StaticResource Text2}" StrokeThickness="1.2"
                                                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                                  Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="{l:T 'Уже стоит у персонажа'}"
                                                                                  Visibility="{Binding InCharacter, Converter={StaticResource Vis}}"/>
                                                                            <Border x:Name="newBadge" Style="{StaticResource Badge}" Margin="6,0,0,0"
                                                                                    Visibility="{Binding IsNew, Converter={StaticResource Vis}}">
                                                                                <TextBlock Text="NEW" FontSize="9" FontWeight="Bold"/>
                                                                            </Border>
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Column="2" Text="{Binding LevelText}" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                                                                   Foreground="{StaticResource Text3}" Margin="10,0,4,0" VerticalAlignment="Center"/>
                                                                        <Button Grid.Column="3" Grid.RowSpan="2" Style="{StaticResource IconButton}" Width="22" Height="22" FontSize="11"
                                                                                Content="&#xE7BF;" VerticalAlignment="Center" Margin="0,0,2,0"
                                                                                Command="{Binding DataContext.TradeGemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}" ToolTip="{l:T 'Найти на трейде (дешёвые сверху)'}"/>
                                                                    </Grid>
                                                                </CheckBox>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSupport}" Value="True">
                                                                        <Setter TargetName="cb" Property="Margin" Value="16,0,0,0"/>
                                                                        <Setter TargetName="name" Property="FontWeight" Value="Normal"/>
                                                                        <Setter TargetName="name" Property="Foreground" Value="{StaticResource Text2}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsBought}" Value="True">
                                                                        <Setter TargetName="name" Property="Foreground" Value="{StaticResource Text3}"/>
                                                                        <Setter TargetName="name" Property="TextDecorations" Value="Strikethrough"/>
                                                                        <Setter TargetName="newBadge" Property="Opacity" Value="0.35"/>
                                                                        <Setter TargetName="source" Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel HorizontalAlignment="Center" Margin="0,30,0,0" Visibility="{Binding ShowAllBought, Converter={StaticResource Vis}}">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="22" HorizontalAlignment="Center"/>
                                <TextBlock Text="{l:T 'На этом этапе всё куплено'}" Foreground="{StaticResource Text2}" Margin="0,8,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{l:T 'В PoB нет гемов для этого этапа'}" Foreground="{StaticResource Text2}" HorizontalAlignment="Center" Margin="0,30,0,0"
                                       Visibility="{Binding HasNoGems, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- links -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,4,0"
                              Visibility="{Binding ShowLinks, Converter={StaticResource Vis}}">
                    <StackPanel Margin="14,0,8,14">
                        <!-- one-off choices of the build: Act 2 bandits, pantheon -->
                        <Border Background="{StaticResource Surface}" CornerRadius="8" Padding="12,9,12,9" Margin="0,0,0,10"
                                Visibility="{Binding HasChoices, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <StackPanel Visibility="{Binding HasBandit, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{l:T 'БАНДИТЫ · АКТ 2'}" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding BanditText}" FontSize="12.5" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Margin="0,8,0,0" Visibility="{Binding HasPantheon, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{l:T 'ПАНТЕОН'}" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding PantheonText}" FontSize="12.5" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- links tab: the stage's links as PoB draws them: main gem, supports hanging off it -->
                        <Border Background="{StaticResource Surface}" CornerRadius="8" Padding="12,10,12,4"
                                Visibility="{Binding HasLinkGroups, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding LinkGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,6">
                                            <!-- which item the link sits in, as PoB says -->
                                            <TextBlock Text="{Binding SlotCaption}" Style="{StaticResource Caption}" FontSize="9.5" Margin="3,2,0,2"
                                                       Visibility="{Binding HasSlot, Converter={StaticResource Vis}}"/>
                                            <ItemsControl ItemsSource="{Binding Gems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- a click copies the gem's name (stash or vendor search) -->
                                                        <Grid x:Name="line" Background="Transparent" Cursor="Hand" ToolTip="{l:T 'Клик — скопировать имя гема'}">
                                                            <Grid.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick"
                                                                              Command="{Binding DataContext.CopyGemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                              CommandParameter="{Binding}"/>
                                                            </Grid.InputBindings>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="branch" Text="{Binding Branch}" Foreground="{StaticResource Text3}"
                                                                       FontSize="12.5" Width="14" Margin="3,0,0,0"/>
                                                            <TextBlock x:Name="name" Grid.Column="1" Foreground="{Binding Brush}" FontSize="12.5"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding NameTip}">
                                                                <Run Text="{Binding Name, Mode=OneWay}"/><Run x:Name="from" Text="{Binding FromText, Mode=OneWay}"
                                                                     Foreground="{StaticResource Text3}" FontStyle="Normal"/><Run Text="{Binding OffText, Mode=OneWay}"
                                                                     Foreground="{StaticResource Text3}" FontStyle="Normal"/>
                                                            </TextBlock>
                                                            <TextBlock x:Name="level" Grid.Column="2" Text="{Binding Level}" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                                                       Foreground="{StaticResource Text3}" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="{Binding LevelTip}"/>
                                                        </Grid>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding KeepLevel}" Value="True">
                                                                <Setter TargetName="level" Property="Foreground" Value="{StaticResource Text}"/>
                                                                <Setter TargetName="level" Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsHead}" Value="True">
                                                                <Setter TargetName="branch" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="name" Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsOff}" Value="True">
                                                                <Setter TargetName="name" Property="Opacity" Value="0.5"/>
                                                                <Setter TargetName="level" Property="Opacity" Value="0.5"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsGranted}" Value="True">
                                                                <Setter TargetName="name" Property="FontStyle" Value="Italic"/>
                                                                <Setter TargetName="line" Property="Cursor" Value="Arrow"/>
                                                                <Setter TargetName="line" Property="ToolTip" Value="{x:Null}"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{StaticResource Text3}" TextWrapping="Wrap" Margin="17,2,0,0"
                                                       Visibility="{Binding HasNote, Converter={StaticResource Vis}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{l:T 'В PoB нет гемов для этого этапа'}" Foreground="{StaticResource Text2}" HorizontalAlignment="Center" Margin="0,30,0,0"
                                   Visibility="{Binding HasNoGems, Converter={StaticResource Vis}}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- gear: the stage's PoB item set as a compact list; a row opens into the card drawn like the game's tooltip -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,4,0"
                              Visibility="{Binding ShowGear, Converter={StaticResource Vis}}">
                    <ScrollViewer.Resources>
                        <DataTemplate x:Key="GearRow">
                            <Border Background="#F00C0B0A" CornerRadius="7" BorderThickness="1" Margin="0,0,0,6">
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="{Binding RarityBrush.Color}" Opacity="0.35"/>
                                </Border.BorderBrush>
                                <StackPanel>
                                    <!-- the row: art | slot, name, what matters | chevron; a click opens or folds the card -->
                                    <Border Background="Transparent" Padding="8,7,6,7" Cursor="Hand" CornerRadius="6">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleCommand}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="40" Height="40" CornerRadius="6" VerticalAlignment="Top">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding RarityBrush.Color}" Opacity="0.08"/>
                                                </Border.Background>
                                                <Image Source="{Binding Icon}" Margin="3" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SlotText}" Style="{StaticResource Caption}" FontSize="9.5"/>
                                                <TextBlock Text="{Binding Title}" Foreground="{Binding RarityBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <ItemsControl ItemsSource="{Binding Summary}" Visibility="{Binding IsCollapsed, Converter={StaticResource Vis}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MoreText}" FontSize="10.5" Foreground="{StaticResource Text3}" VerticalAlignment="Center" Margin="0,0,4,0"
                                                           Visibility="{Binding IsCollapsed, Converter={StaticResource Vis}}"/>
                                                <TextBlock x:Name="chevron" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{StaticResource Text3}"
                                                           VerticalAlignment="Center" Margin="2,0,4,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- the full card, like the game's tooltip -->
                                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}" Margin="0,0,0,8">
                                        <Border Height="1" Margin="10,0,10,0">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding RarityBrush.Color}" Opacity="0.25"/>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Text="{Binding BaseType}" Foreground="{Binding RarityBrush}" FontSize="12" Opacity="0.85"
                                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="10,6,10,0"
                                                   Visibility="{Binding ShowBase, Converter={StaticResource Vis}}"/>
                                        <!-- the item's influences, each in the colour its mods are painted below -->
                                        <ItemsControl ItemsSource="{Binding Influences}" HorizontalAlignment="Center" Margin="0,2,0,0"
                                                      Visibility="{Binding HasInfluences, Converter={StaticResource Vis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontSize="11">
                                                        <Run Text="{Binding Sep, Mode=OneWay}" Foreground="{StaticResource Text3}"/><Run Text="{Binding Name, Mode=OneWay}" Foreground="{Binding Brush}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding SocketsText}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                   Foreground="{StaticResource Text3}" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                   Visibility="{Binding HasSockets, Converter={StaticResource Vis}}"/>
                                        <ItemsControl ItemsSource="{Binding Implicits}" Margin="10,6,10,0"
                                                      Visibility="{Binding HasImplicits, Converter={StaticResource Vis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- an anointment: its three oils beside it, the name on hover -->
                                                    <WrapPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                                                                   VerticalAlignment="Center"/>
                                                        <ItemsControl ItemsSource="{Binding Oils}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                      Visibility="{Binding HasOils, Converter={StaticResource Vis}}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="Transparent" Padding="1,0" ToolTip="{Binding Name}" Cursor="Help"
                                                                            Width="22" Height="22">
                                                                        <Grid>
                                                                            <!-- the game's oil icon; a drop in the oil's colour until it is downloaded -->
                                                                            <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                                                                   Visibility="{Binding HasIcon, Converter={StaticResource Vis}}"/>
                                                                            <Path Data="M5,0 C5,0 10,6.5 10,9.5 A5,5 0 0 1 0,9.5 C0,6.5 5,0 5,0 Z" Width="10" Height="15"
                                                                                  Fill="{Binding Fill}" Stroke="{Binding Edge}" StrokeThickness="1" Stretch="None"
                                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                  Visibility="{Binding HasIcon, Converter={StaticResource NotVis}}"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </WrapPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Height="1" Margin="40,7,40,1" Visibility="{Binding HasImplicits, Converter={StaticResource Vis}}">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding RarityBrush.Color}" Opacity="0.35"/>
                                            </Border.Background>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Explicits}" Margin="10,6,10,0"
                                                      Visibility="{Binding HasExplicits, Converter={StaticResource Vis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Corrupted" Foreground="{Binding CorruptBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                   Visibility="{Binding Corrupted, Converter={StaticResource Vis}}"/>
                                        <!-- a cluster jewel: its small passives on this stage's tree (the notables are painted on their own lines) -->
                                        <ItemsControl ItemsSource="{Binding TreeLines}" Margin="10,8,10,0"
                                                      Visibility="{Binding HasTreeLines, Converter={StaticResource Vis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- two separate actions, like the trade sites do: search, or the item text for PoB / chat -->
                                        <Grid Margin="10,10,10,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Style="{StaticResource GhostButton}" Content="{Binding TradeButton}" Command="{Binding TradeCommand}"
                                                    ToolTip="{l:T 'Окно прайс-чека на этот предмет: выбери фильтры, потом «Искать» или «Открыть на трейде»'}"/>
                                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="{Binding CopyButton}" Command="{Binding CopyCommand}"
                                                    ToolTip="{l:T 'Текст предмета в буфер: вставить в PoB (Create custom) или в чат'}"/>
                                        </Grid>
                                        <!-- a timeless jewel: what it does around its socket, on Vilsol's calculator -->
                                        <Button Style="{StaticResource GhostButton}" Content="{l:T 'Что даёт в этом сокете ↗'}" Command="{Binding TimelessCommand}"
                                                Margin="10,6,10,0" ToolTip="{Binding TimelessTip}"
                                                Visibility="{Binding HasTimeless, Converter={StaticResource Vis}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                    <Setter TargetName="chevron" Property="Text" Value="&#xE70E;"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ScrollViewer.Resources>
                    <StackPanel Margin="14,0,8,14">
                        <Grid Margin="4,0,0,6">
                            <TextBlock Text="{Binding GearCaption}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,90,0"/>
                            <Button Style="{StaticResource GhostButton}" Content="{Binding ExpandAllText}" Command="{Binding ExpandAllCommand}" HorizontalAlignment="Right"
                                    Padding="8,2" FontSize="11" FontWeight="Normal" Visibility="{Binding HasGear, Converter={StaticResource Vis}}"/>
                        </Grid>
                        <Border BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,10"
                                Visibility="{Binding HasGearNote, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding GearNote}" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource Text2}"/>
                        </Border>
                        <ItemsControl ItemsSource="{Binding GearWorn}" ItemTemplate="{StaticResource GearRow}"/>
                        <!-- jewels in the stage's tree, clusters among them: a group of their own, not lost under the flasks -->
                        <TextBlock Text="{Binding JewelsCaption}" Style="{StaticResource Caption}" Margin="4,12,0,6"
                                   Visibility="{Binding HasJewels, Converter={StaticResource Vis}}"/>
                        <ItemsControl ItemsSource="{Binding GearJewels}" ItemTemplate="{StaticResource GearRow}"/>
                        <TextBlock Text="{l:T 'В PoB нет шмота для этого этапа'}" Foreground="{StaticResource Text2}" HorizontalAlignment="Center" Margin="0,30,0,0"
                                   Visibility="{Binding HasNoGear, Converter={StaticResource Vis}}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- tree summary -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,4,0"
                              Visibility="{Binding ShowTreeTab, Converter={StaticResource Vis}}">
                    <StackPanel Margin="14,0,8,14">
                        <Border Background="{StaticResource Surface}" CornerRadius="10" Padding="12,9" Margin="0,0,0,10"
                                Visibility="{Binding HasTreeHint, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding TreeHint}" Foreground="{StaticResource Text2}" TextWrapping="Wrap" FontSize="12"/>
                        </Border>

                        <UniformGrid Columns="3" Margin="0,0,-6,0">
                            <Border Background="{StaticResource Surface}" CornerRadius="8" Padding="12,10" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding PointsToTake}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold"/>
                                    <TextBlock Text="{l:T 'ВЗЯТЬ'}" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Surface}" CornerRadius="8" Padding="12,10" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding RefundCount}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold"/>
                                    <TextBlock Text="{l:T 'СНЯТЬ'}" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Surface}" CornerRadius="8" Padding="12,10" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding AscendancyCount}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold"/>
                                    <TextBlock Text="{l:T 'АСЦЕНД'}" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Background="{StaticResource Surface}" CornerRadius="10" Padding="3" Margin="0,12,0,0">
                            <UniformGrid Rows="1">
                                <RadioButton Style="{StaticResource Segment}" GroupName="cmp" Content="{l:T 'От прошлого этапа'}" IsChecked="{Binding CompareWithPrevious}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="cmp" Content="{l:T 'От персонажа'}" IsChecked="{Binding CompareWithCharacter}"/>
                            </UniformGrid>
                        </Border>
                        <TextBlock Text="{Binding CompareHint}" Foreground="{StaticResource Text3}" FontSize="11.5" Margin="4,6,0,0" TextWrapping="Wrap"/>

                        <Button Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" Click="OpenTree_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{l:T 'Открыть дерево'}"/>
                                <TextBlock Text="{Binding KeyTree}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Opacity="0.55" Margin="10,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Visibility="{Binding HasAscendancy, Converter={StaticResource Vis}}" Margin="0,18,0,0">
                            <TextBlock Text="{l:T 'АСЦЕНДАНСИ'}" Style="{StaticResource Caption}" Margin="4,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding AscendancyNodes}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" Padding="10,4" Margin="0,0,6,6">
                                            <TextBlock Text="{Binding}" FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasKeyNodes, Converter={StaticResource Vis}}" Margin="0,16,0,0">
                            <TextBlock Text="{l:T 'ПОРЯДОК КЛЮЧЕВЫХ УЗЛОВ'}" Style="{StaticResource Caption}" Margin="4,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding KeyNodes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Step}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Text3}" Margin="0,2,0,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{StaticResource Text3}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- footer -->
            <!-- shown on every full page: the close-app button lives here; the progress only on the gems tab -->
            <Grid Grid.Row="4" Margin="18,6,18,16" Visibility="{Binding IsCompact, Converter={StaticResource NotVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Height="2" CornerRadius="1" Background="{StaticResource Surface3}" ClipToBounds="True"
                        Visibility="{Binding ShowGems, Converter={StaticResource Vis}}">
                    <Border Background="{StaticResource Accent}" CornerRadius="1" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Progress}"/>
                        </Border.RenderTransform>
                    </Border>
                </Border>
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource Text2}" FontSize="11.5" VerticalAlignment="Center"
                               Visibility="{Binding ShowGems, Converter={StaticResource Vis}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- was a settings button: an action of the gems tab, so it lives by the gems -->
                        <Button Style="{StaticResource IconButton}" Content="&#xE762;" FontSize="13" Margin="0,0,6,0" Command="{Binding MarkAllCommand}"
                                ToolTip="{l:T 'Отметить / снять все гемы этапа'}" Visibility="{Binding ShowGems, Converter={StaticResource Vis}}"/>
                        <ToggleButton Style="{StaticResource Chip}" Content="{l:T 'Скрыть купленные'}" IsChecked="{Binding HideBought}"
                                      Visibility="{Binding ShowGems, Converter={StaticResource Vis}}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE7E8;" FontSize="12" Margin="6,0,0,0"
                                ToolTip="{l:T 'Закрыть приложение'}" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- toast: over the full panel above the footer; in the mini tracker a strip under its line (the footer row is
                 empty there), so it neither hides the stage nor blows the one-line window up with a margin -->
            <Border Background="{StaticResource Accent}" IsHitTestVisible="False"
                    Visibility="{Binding IsToastVisible, Converter={StaticResource Vis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Grid.Row" Value="0"/>
                        <Setter Property="Grid.RowSpan" Value="5"/>
                        <Setter Property="VerticalAlignment" Value="Bottom"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="16,0,16,62"/>
                        <Setter Property="CornerRadius" Value="8"/>
                        <Setter Property="Padding" Value="14,8"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                <Setter Property="Grid.Row" Value="4"/>
                                <Setter Property="Grid.RowSpan" Value="1"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter Property="Margin" Value="6,0,6,6"/>
                                <Setter Property="CornerRadius" Value="6"/>
                                <Setter Property="Padding" Value="10,6"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ToastText}" Foreground="{StaticResource OnAccent}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
    </Border>
</Window>
