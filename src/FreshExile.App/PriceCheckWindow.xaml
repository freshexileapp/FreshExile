<Window x:Class="FreshExile.App.PriceCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FreshExile.App"
        Title="{l:T 'Fresh Exile · прайс-чек'}" Width="540" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        UseLayoutRounding="True">

    <ContentControl Style="{StaticResource WindowFrame}">
        <StackPanel UseLayoutRounding="True">
            <!-- header, like the game's tooltip: "Прайс-чек", the name in the rarity colour, base; the answer and links on the right -->
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" CornerRadius="9,9,0,0" MouseLeftButtonDown="Drag_MouseDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{StaticResource Surface2Color}" Offset="0"/>
                        <GradientStop Color="{StaticResource PanelColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            <Grid Margin="16,12,8,10" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{l:T 'Прайс-чек'}" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FsCaption}" Foreground="{StaticResource Bronze}"/>
                    <TextBlock x:Name="TitleText" Text="{Binding Title}" Foreground="{Binding RarityBrush}" FontFamily="{StaticResource DisplayFont}"
                               FontSize="{StaticResource FsTitle}" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    <TextBlock Text="{Binding BaseLine}" Foreground="{StaticResource Text2}" FontSize="{StaticResource FsSmall}"
                               Visibility="{Binding HasBaseLine, Converter={StaticResource Vis}}"/>
                    <TextBlock Text="{Binding AffixLine}" Foreground="{StaticResource Text3}" FontSize="{StaticResource FsSmall}" Margin="0,1,0,0"
                               ToolTip="{Binding AffixTip}" Visibility="{Binding HasAffixLine, Converter={StaticResource Vis}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- the answer, in chaos-orb gold so it is the first thing the eye finds -->
                        <Border Background="{StaticResource Gold}" CornerRadius="{StaticResource RadiusM}" Padding="9,2,9,3" Margin="0,0,6,0" VerticalAlignment="Center"
                                Visibility="{Binding HasLowest, Converter={StaticResource Vis}}" ToolTip="{l:T 'Самое дешёвое предложение с трейда'}">
                            <TextBlock Text="{Binding LowestText}" FontSize="{StaticResource FsBody}" FontWeight="SemiBold" Foreground="{StaticResource OnAccent}"/>
                        </Border>
                        <!-- the market rate is the price of currency and the like: the same gold as the cheapest offer -->
                        <Border CornerRadius="{StaticResource RadiusM}" Padding="8,3" Margin="0,0,6,0" VerticalAlignment="Center"
                                Visibility="{Binding HasNinja, Converter={StaticResource Vis}}" ToolTip="{Binding NinjaTip}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource Surface}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMarketPrice}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Gold}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding NinjaText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Text2}"/>
                                        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                        <Setter Property="FontSize" Value="{StaticResource FsSmall}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMarketPrice}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
                                                <Setter Property="FontSize" Value="{StaticResource FsBody}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="{StaticResource FsCaption}" ToolTip="{l:T 'Закрыть · Esc'}" Click="Close_Click"/>
                    </StackPanel>
                    <!-- small outlined links -->
                    <StackPanel x:Name="Links" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,8,0">
                        <Button Style="{StaticResource SmallButton}" Content="Wiki" Command="{Binding WikiCommand}" Margin="0,0,4,0"
                                Background="Transparent" BorderBrush="{StaticResource LineStrong}" Foreground="{StaticResource Text2}"/>
                        <Button Style="{StaticResource SmallButton}" Content="PoEDB" Command="{Binding PoedbCommand}" Margin="0,0,4,0"
                                Background="Transparent" BorderBrush="{StaticResource LineStrong}" Foreground="{StaticResource Text2}"/>
                        <Button Style="{StaticResource SmallButton}" Content="{l:T 'Сид'}" Command="{Binding TimelessCommand}" Margin="0,0,4,0"
                                Background="Transparent" BorderBrush="{StaticResource LineStrong}" Foreground="{StaticResource Text2}"
                                ToolTip="{l:T 'Что меняет этот сид: калькулятор vilsol.github.io/timeless-jewels'}"
                                Visibility="{Binding HasTimeless, Converter={StaticResource Vis}}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            </Border>

            <!-- no item under the mouse -->
            <TextBlock x:Name="MessageText" Margin="16,10,16,16" FontSize="{StaticResource FsSmall}" TextWrapping="Wrap" Foreground="{StaticResource Text2}" Visibility="Collapsed"/>

            <StackPanel x:Name="Body">
                <!-- a cluster for the build: the main filter, a card of its own above the rest -->
                <Border Margin="14,12,14,0" BorderBrush="{StaticResource Bronze}" BorderThickness="1" CornerRadius="{StaticResource RadiusM}" Padding="12,10"
                        Visibility="{Binding HasClusterLayout, Converter={StaticResource Vis}}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource FlameSoftColor}" Offset="0"/>
                            <GradientStop Color="{StaticResource PanelClearColor}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="{StaticResource FlameColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.18"/>
                    </Border.Effect>
                    <StackPanel>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding UseClusterLayoutOn}" VerticalAlignment="Center"/>
                            <Image Source="logo.png" Width="22" Height="22" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{l:T 'Под мой билд'}" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FsSection}" FontWeight="Bold"
                                               Foreground="{StaticResource AccentHover}"/>
                                    <TextBlock Text="{l:T '— выкл.'}" Margin="6,0,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FsSection}" FontWeight="Medium"
                                               Foreground="{StaticResource Text3}" Visibility="{Binding ClusterOff, Converter={StaticResource Vis}}"/>
                                </StackPanel>
                                <TextBlock Text="{l:T 'кластер из дерева этапа'}" FontSize="{StaticResource FsCaption}" Foreground="{StaticResource Text3}"/>
                            </StackPanel>
                        </DockPanel>
                        <!-- what the search asks: these, plus any N of those -->
                        <Grid Margin="0,10,0,0" Visibility="{Binding UseClusterLayoutOn, Converter={StaticResource Vis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{l:T 'Обязательно'}" FontSize="{StaticResource FsCaption}" Foreground="{StaticResource Text3}" Margin="0,5,0,0"/>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding ClusterWanted}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Accent}" CornerRadius="{StaticResource RadiusS}" Padding="7,2,8,3" Margin="0,0,5,5">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M1,5.2 L3.8,8 L9,2" Width="10" Height="10" Stretch="None" Stroke="{StaticResource OnAccent}" StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding}" FontSize="{StaticResource FsSmall}" FontWeight="SemiBold" Foreground="{StaticResource OnAccent}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Grid.Row="1" Text="{Binding ClusterAnyLabel}" FontSize="{StaticResource FsCaption}" Foreground="{StaticResource Text3}" Margin="0,5,8,0"
                                       TextWrapping="Wrap"/>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <ItemsControl ItemsSource="{Binding ClusterOthers}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BronzeLine}" BorderThickness="1" CornerRadius="{StaticResource RadiusS}" Padding="7,1,8,2" Margin="0,0,5,5">
                                                <TextBlock Text="{Binding}" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource Text}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{l:T 'встают на кольце дальше моих — к моим не надо идти через них'}" FontSize="{StaticResource FsCaption}"
                                           Foreground="{StaticResource Text3}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding ClusterSkippedText}" FontSize="{StaticResource FsCaption}" Foreground="{StaticResource Text3}"
                                       Margin="0,6,0,0" ToolTip="{l:T 'Эти нотабли встали бы на пути к моим: такой кластер не подходит'}"
                                       Visibility="{Binding HasClusterSkipped, Converter={StaticResource Vis}}"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- what the search keeps from the item, in two labelled rows: the item itself, its state -->
                <Grid Margin="16,12,14,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{l:T 'Предмет'}" FontSize="{StaticResource FsCaption}" Foreground="{StaticResource Text3}" Margin="0,7,0,0"/>
                    <WrapPanel Grid.Column="1">
                    <ToggleButton Style="{StaticResource Chip}" Content="{Binding BaseChip}" IsChecked="{Binding UseBase}" Margin="0,0,6,6"
                                  ToolTip="{l:T 'Искать именно эту базу, а не любой предмет этого слота'}"
                                  Visibility="{Binding CanToggleBase, Converter={StaticResource Vis}}"/>
                    <ToggleButton Style="{StaticResource Chip}" Content="{l:T 'Только магия'}" IsChecked="{Binding UseRarity}" Margin="0,0,6,6"
                                  ToolTip="{l:T 'Сравнивать с магическими: рар с теми же модами и ещё двумя — другой товар'}"
                                  Visibility="{Binding HasRarityChip, Converter={StaticResource Vis}}"/>
                    <ToggleButton Style="{StaticResource Chip}" Content="{Binding ItemLevelChip}" IsChecked="{Binding UseItemLevel}" Margin="0,0,6,6"
                                  ToolTip="{l:T 'Не ниже уровня этого предмета (важно для крафта)'}"
                                  Visibility="{Binding HasItemLevel, Converter={StaticResource Vis}}"/>
                    <ToggleButton Style="{StaticResource Chip}" Content="{Binding LevelCapChip}" IsChecked="{Binding UseLevelCap}" Margin="0,0,6,6"
                                  ToolTip="{l:T 'Только то, что персонаж может надеть сейчас: требуемый уровень не выше его уровня (из лога игры)'}"
                                  Visibility="{Binding HasLevelCap, Converter={StaticResource Vis}}"/>
                    <ToggleButton Style="{StaticResource Chip}" Content="{Binding QualityChip}" IsChecked="{Binding UseQuality}" Margin="0,0,6,6"
                                  Visibility="{Binding HasQuality, Converter={StaticResource Vis}}"/>
                    <ToggleButton Style="{StaticResource Chip}" Content="{l:T 'Точные значения'}" IsChecked="{Binding ExactValues}" Margin="0,0,6,6"
                                  ToolTip="{l:T 'Минимумы ровно как у предмета, а не процент от них'}"
                                  Visibility="{Binding HasExact, Converter={StaticResource Vis}}"/>
                    <ToggleButton Style="{StaticResource Chip}" Content="{Binding LinksChip}" IsChecked="{Binding UseLinks}" Margin="0,0,6,6"
                                  Visibility="{Binding HasLinks, Converter={StaticResource Vis}}"/>
                    <ToggleButton Style="{StaticResource Chip}" Content="{Binding HeistJobChip}" IsChecked="{Binding UseHeistJob}" Margin="0,0,6,6"
                                  ToolTip="{l:T 'Работа контракта не ниже его уровня'}" Visibility="{Binding HasHeistJob, Converter={StaticResource Vis}}"/>
                    <ToggleButton Style="{StaticResource Chip}" Content="{Binding AreaLevelChip}" IsChecked="{Binding UseAreaLevel}" Margin="0,0,6,6"
                                  ToolTip="{l:T 'Уровень зоны контракта не ниже этого'}" Visibility="{Binding HasAreaLevel, Converter={StaticResource Vis}}"/>
                    <!-- a gem: level and quality from; empty = any -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,6,6" Visibility="{Binding IsGem, Converter={StaticResource Vis}}">
                        <TextBlock Text="{l:T 'Ур. от'}" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="2,0,5,0"
                                   ToolTip="{Binding GemLevelTip}"/>
                        <TextBox Style="{StaticResource Field}" Width="38" Padding="6,4" FontSize="{StaticResource FsSmall}" FontFamily="{StaticResource MonoFont}"
                                 Text="{Binding GemLevelText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding GemLevelTip}" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:T 'Кач. от'}" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="10,0,5,0"/>
                        <TextBox Style="{StaticResource Field}" Width="38" Padding="6,4" FontSize="{StaticResource FsSmall}" FontFamily="{StaticResource MonoFont}"
                                 Text="{Binding GemQualityText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:T 'Качество, %; пусто — любое'}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Background="{StaticResource Surface}" CornerRadius="{StaticResource RadiusM}" Padding="10,5" Margin="0,0,6,6"
                            Visibility="{Binding HasInfoChip, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding InfoChip}" FontSize="{StaticResource FsSmall}" FontWeight="SemiBold" Foreground="{StaticResource Text2}"/>
                    </Border>
                    </WrapPanel>
                    <TextBlock Grid.Row="1" Text="{l:T 'Состояние'}" FontSize="{StaticResource FsCaption}" Foreground="{StaticResource Text3}" Margin="0,8,0,0"/>
                    <!-- two per row (a hidden one takes no cell), the captions one width, right against their segments -->
                    <UniformGrid Grid.Row="1" Grid.Column="1" Columns="2" Grid.IsSharedSizeScope="True" HorizontalAlignment="Left">
                    <l:TriSegment Label="{l:T 'Коррапт'}" Value="{Binding CorruptedState}" Margin="0,0,20,6"/>
                    <l:TriSegment Label="Mirrored" Value="{Binding MirroredState}" Margin="0,0,20,6"
                                  Visibility="{Binding IsEquipment, Converter={StaticResource Vis}}"/>
                    <l:TriSegment Label="Fractured" Value="{Binding FracturedState}" Margin="0,0,20,6"
                                  Visibility="{Binding HasFractured, Converter={StaticResource Vis}}"/>
                    <l:TriSegment Label="{l:T 'Неопознан'}" Value="{Binding UnidState}" Margin="0,0,20,6"
                                  Visibility="{Binding IsUnique, Converter={StaticResource Vis}}"/>
                    <l:TriSegment Label="Foulborn" Value="{Binding FoulbornState}" Margin="0,0,20,6"
                                  Visibility="{Binding IsUnique, Converter={StaticResource Vis}}"/>
                    </UniformGrid>
                </Grid>

                <l:OrnamentDivider Margin="16,6,16,2" Visibility="{Binding HasFilters, Converter={StaticResource Vis}}"/>
                <!-- the min / max columns named once, above them -->
                <Grid Margin="7,0,24,2" Visibility="{Binding HasFilters, Converter={StaticResource Vis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="54"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="54"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="{l:T 'мин'}" FontSize="{StaticResource FsCaption}" Foreground="{StaticResource Text3}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{l:T 'макс'}" FontSize="{StaticResource FsCaption}" Foreground="{StaticResource Text3}" HorizontalAlignment="Center"/>
                </Grid>

                <!-- filters: tick, line, tier, min, max -->
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Visible" Margin="7,0,2,0"
                              Visibility="{Binding HasFilters, Converter={StaticResource Vis}}">
                    <ItemsControl ItemsSource="{Binding Filters}" Margin="0,0,6,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="row" Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="54"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="54"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="tick" Style="{StaticResource GemCheck}" IsChecked="{Binding Enabled}" IsEnabled="{Binding Searchable}"
                                              ToolTip="{Binding ToolTip}">
                                        <WrapPanel>
                                            <!-- "!": unticked, but this line alone can make the price -->
                                            <Border Background="{StaticResource Gold}" CornerRadius="{StaticResource RadiusS}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                                    ToolTip="{Binding Hint}" Visibility="{Binding ShowHint, Converter={StaticResource Vis}}">
                                                <TextBlock Text="!" FontSize="{StaticResource FsSmall}" FontWeight="Bold" Foreground="{StaticResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock x:Name="label" Foreground="{Binding Brush}" FontSize="{StaticResource FsSmall}" TextWrapping="Wrap" Margin="0,0,6,0">
                                                <Run Text="{Binding Label, Mode=OneWay}"/><Run Text="{Binding RangeSuffix, Mode=OneWay}" FontSize="{StaticResource FsCaption}"
                                                     Foreground="{StaticResource Text3}"/>
                                            </TextBlock>
                                            <!-- an anointment: its three oils, the name on hover -->
                                            <ItemsControl ItemsSource="{Binding Oils}" Margin="0,0,6,0" VerticalAlignment="Center"
                                                          Visibility="{Binding HasOils, Converter={StaticResource Vis}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="Transparent" Padding="1,0" ToolTip="{Binding Name}" Cursor="Help" Width="20" Height="20">
                                                            <Grid>
                                                                <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                                                       Visibility="{Binding HasIcon, Converter={StaticResource Vis}}"/>
                                                                <Path Data="M5,0 C5,0 10,6.5 10,9.5 A5,5 0 0 1 0,9.5 C0,6.5 5,0 5,0 Z" Width="10" Height="15"
                                                                      Fill="{Binding Fill}" Stroke="{Binding Edge}" StrokeThickness="1" Stretch="None"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      Visibility="{Binding HasIcon, Converter={StaticResource NotVis}}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding ClusterTag}" FontSize="{StaticResource FsCaption}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                       Visibility="{Binding HasClusterTag, Converter={StaticResource Vis}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsClusterOther}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Text3}"/>
                                                                <Setter Property="FontWeight" Value="Normal"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border Style="{StaticResource Badge}" Margin="0,0,5,0" BorderBrush="{StaticResource LineStrong}"
                                                    Visibility="{Binding HasTier, Converter={StaticResource Vis}}">
                                                <TextBlock x:Name="tier" Text="{Binding TierText}" FontSize="{StaticResource FsCaption}" FontWeight="SemiBold" Foreground="{StaticResource Text2}"/>
                                            </Border>
                                            <TextBlock Text="{Binding KindText}" FontSize="{StaticResource FsCaption}" Foreground="{StaticResource Text3}" VerticalAlignment="Center"
                                                       Visibility="{Binding HasKind, Converter={StaticResource Vis}}"/>
                                        </WrapPanel>
                                    </CheckBox>
                                    <TextBox x:Name="min" Grid.Column="1" Style="{StaticResource Field}" Padding="6,4" FontSize="{StaticResource FsSmall}" FontFamily="{StaticResource MonoFont}"
                                             Tag="—" Text="{Binding MinText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="0,2,0,2"
                                             IsEnabled="{Binding Searchable}"/>
                                    <TextBox x:Name="max" Grid.Column="3" Style="{StaticResource Field}" Padding="6,4" FontSize="{StaticResource FsSmall}" FontFamily="{StaticResource MonoFont}"
                                             Tag="—" Text="{Binding MaxText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="0,2,0,2"
                                             IsEnabled="{Binding Searchable}"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                        <Setter TargetName="label" Property="Opacity" Value="0.75"/>
                                        <Setter TargetName="min" Property="Opacity" Value="0.45"/>
                                        <Setter TargetName="max" Property="Opacity" Value="0.45"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Searchable}" Value="False">
                                        <Setter TargetName="label" Property="Opacity" Value="0.35"/>
                                    </DataTrigger>
                                    <!-- one of the card's "any of N": the card decides it, not its tick -->
                                    <DataTrigger Binding="{Binding IsClusterOther}" Value="True">
                                        <Setter TargetName="row" Property="Opacity" Value="0.7"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                        <Setter TargetName="row" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsTopTier}" Value="True">
                                        <Setter TargetName="tier" Property="Foreground" Value="{StaticResource Text}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Style="{StaticResource GhostButton}" Content="{Binding FoldText}" Command="{Binding ToggleFiltersCommand}" HorizontalAlignment="Left"
                        Margin="14,4,0,0" Padding="10,3" FontSize="{StaticResource FsSmall}" FontWeight="Normal" BorderBrush="Transparent" Background="Transparent"
                        Foreground="{StaticResource Text2}" Visibility="{Binding HasFolded, Converter={StaticResource Vis}}"/>

                <!-- search / open on the site; the bar under them is the cooldown -->
                <Grid Margin="14,12,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding SearchText}" Command="{Binding SearchCommand}" Height="40" Padding="16,0"/>
                        <!-- the pause between requests: a thin bar along the bottom of "Искать", not a divider -->
                        <Border Height="2" VerticalAlignment="Bottom" Margin="8,0,8,3" ClipToBounds="True" IsHitTestVisible="False"
                                ToolTip="{l:T 'Пауза между запросами, чтобы трейд не выдал бан'}">
                            <Border Background="{StaticResource OnAccent}" Opacity="0.35" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding CooldownLeft}"/>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </Grid>
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="{l:T 'Открыть на трейде ↗'}" Command="{Binding OpenTradeCommand}" Height="40"
                            Padding="14,0" Background="Transparent" ToolTip="{l:T 'Тот же поиск в браузере'}"/>
                </Grid>
                <!-- the block of offers starts at a diamond: "Найдено · 385" -->
                <l:OrnamentDivider Text="{Binding FoundText}" Margin="14,12,14,0"/>
                <!-- "Covens · 1 div ≈ 174c" quiet under the buttons; the search's own answer under it -->
                <TextBlock Margin="16,4,16,0" FontSize="{StaticResource FsCaption}" Foreground="{StaticResource Text3}" ToolTip="{Binding RateTable}" HorizontalAlignment="Center">
                    <Run Text="{Binding League, Mode=OneWay}"/><Run Text="{Binding RateText, Mode=OneWay, StringFormat='  ·  {0}'}"/>
                </TextBlock>
                <TextBlock x:Name="status" Margin="16,4,16,4" Text="{Binding Status}" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource Text2}" TextWrapping="Wrap"
                           Visibility="{Binding HasStatus, Converter={StaticResource Vis}}"/>

                <!-- offers, cheapest first -->
                <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Visible" Margin="14,0,2,0"
                              Visibility="{Binding HasListings, Converter={StaticResource Vis}}">
                    <ItemsControl ItemsSource="{Binding Listings}" Margin="0,0,6,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- art | price | seller and item | how long ago, all centred in the row -->
                                <Border Background="{StaticResource Surface}" CornerRadius="{StaticResource RadiusM}" Padding="8,6,6,6" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="92"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Icon}" Width="30" Height="30" Stretch="Uniform" VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding Price}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FsBody}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Image Source="{Binding CurrencyIcon}" Width="20" Height="20" Margin="3,0,0,0" VerticalAlignment="Center" ToolTip="{Binding Currency}"
                                                   RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasCurrencyIcon, Converter={StaticResource Vis}}"/>
                                            <TextBlock Text="{Binding CurrencyText}" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource Text2}" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Account}" FontSize="{StaticResource FsSmall}" Foreground="{StaticResource Text2}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Extra}" FontSize="{StaticResource FsCaption}" Foreground="{StaticResource Text3}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding Age}" FontSize="{StaticResource FsCaption}" Foreground="{StaticResource Text3}" VerticalAlignment="Center"/>
                                        <!-- ours vs this offer: opens the comparison window beside this one -->
                                        <ToggleButton Grid.Column="4" Style="{StaticResource IconToggle}" Width="26" Height="26" FontSize="{StaticResource FsSmall}" Margin="4,0,0,0"
                                                      Content="&#xE8AB;" ToolTip="{l:T 'Сравнить с моим'}" IsChecked="{Binding IsComparing}"
                                                      Visibility="{Binding CanCompare, Converter={StaticResource Vis}}"/>
                                        <!-- an "in person" offer: the site's message to the seller, straight into the game's chat -->
                                        <Button Grid.Column="5" Style="{StaticResource GhostButton}" Content="{Binding WhisperText}" Command="{Binding WhisperCommand}"
                                                Padding="9,4" FontSize="{StaticResource FsSmall}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                ToolTip="{Binding Whisper}" Visibility="{Binding HasWhisperButton, Converter={StaticResource Vis}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button Style="{StaticResource GhostButton}" Content="{l:T 'Ещё 10'}" Command="{Binding MoreCommand}" Margin="14,4,14,0" Padding="10,6"
                        Visibility="{Binding HasMore, Converter={StaticResource Vis}}"/>
                <Border Height="12"/>
            </StackPanel>
        </StackPanel>
    </ContentControl>
</Window>
