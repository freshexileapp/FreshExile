<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FreshExile.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data/ClusterNotables.tsv" LogicalName="ClusterNotables.tsv" />
    <!-- which notables can roll for each cluster enchant, from RePoE: tools/update-cluster-skills.ps1 -->
    <EmbeddedResource Include="Data/ClusterSkills.tsv" LogicalName="ClusterSkills.tsv" />
    <!-- how far each proxy group turns a cluster's ring: PoB's Data/ClusterJewels.lua orbitOffsets -->
    <EmbeddedResource Include="Data/ClusterOrbitOffsets.tsv" LogicalName="ClusterOrbitOffsets.tsv" />
    <!-- the icons of cluster small passives (the export has only the notables'): tools/update-cluster-icons.ps1 -->
    <EmbeddedResource Include="Data/ClusterIcons.tsv" LogicalName="ClusterIcons.tsv" />
    <!-- bases and their prefixes / suffixes from RePoE: tools/update-mod-tiers.ps1 -->
    <EmbeddedResource Include="Data/ModTiers.tsv" LogicalName="ModTiers.tsv" />
    <!-- mod lines of the influences (eldritch implicits, Shaper / Elder / conqueror explicits): tools/update-influence-mods.ps1 -->
    <EmbeddedResource Include="Data/InfluenceMods.tsv" LogicalName="InfluenceMods.tsv" />
    <!-- the mods a map rolls, for the map regex window: tools/update-map-mods.ps1 -->
    <EmbeddedResource Include="Data/MapMods.tsv" LogicalName="MapMods.tsv" />
    <!-- mercenary builds, skills and the supports each skill can carry: tools/update-merc-data.ps1 -->
    <EmbeddedResource Include="Data/Mercenaries.tsv" LogicalName="Mercenaries.tsv" />
    <!-- the interface in English, keyed by its Russian text: see Loc -->
    <EmbeddedResource Include="Data/en.json" LogicalName="en.json" />
  </ItemGroup>

</Project>
